<UserControl x:Class="ThatsMyQuant.Dashboard.Controls.ScientificChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="1040">
    <Grid Background="{StaticResource AppBg}"
          SizeChanged="RootGrid_SizeChanged">
        <Border Background="#0B0E13"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="#0F131B"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ComboBox x:Name="SymbolSelector"
                                      ItemsSource="{Binding Symbols}"
                                      SelectedItem="{Binding SelectedSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Text="{Binding SelectedSymbol, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      MinWidth="140"
                                      MaxWidth="200"
                                      FontSize="14"
                                      FontWeight="Black"
                                      Background="#0F131B"
                                      BorderBrush="{StaticResource Accent}"
                                      Foreground="{StaticResource TextMain}"
                                      Margin="0,0,14,0"
                                      Padding="10,4"
                                      ToolTip="Type a symbol and press Enter, or pick from the list."
                                      KeyDown="SymbolSelector_KeyDown" />
                            <TextBlock Text="{Binding ChartHeaderOhlc}"
                                       Foreground="{Binding ChartHeaderChangeColor}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="#121826"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding SelectedTimeframe}"
                                           Foreground="{StaticResource TextMain}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                            <Border Background="#121826"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4">
                                <TextBlock Text="{Binding SelectedMarket}"
                                           Foreground="{StaticResource TextSoft}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Background="#0F131B"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,10,0,10"
                                VerticalAlignment="Stretch">
                        <Button Content="Pan"
                                Click="PanTool_Click"
                                Style="{StaticResource InstitutionalGlassButton}"
                                Width="40" Height="34" Margin="10,0,10,8"
                                FontSize="10" FontWeight="Bold"
                                ToolTip="Pan" />
                        <Button Content="✛"
                                Click="CrosshairTool_Click"
                                Style="{StaticResource InstitutionalGlassButton}"
                                Width="40" Height="34" Margin="10,0,10,8"
                                FontSize="12" FontWeight="Bold"
                                ToolTip="Crosshair" />
                        <Button Content="⟋"
                                Click="TrendTool_Click"
                                Style="{StaticResource InstitutionalGlassButton}"
                                Width="40" Height="34" Margin="10,0,10,8"
                                FontSize="14" FontWeight="Bold"
                                ToolTip="Trend line" />
                        <Button Content="↶"
                                Click="UndoTool_Click"
                                Style="{StaticResource InstitutionalGlassButton}"
                                Width="40" Height="34" Margin="10,0,10,8"
                                FontSize="14" FontWeight="Bold"
                                ToolTip="Undo last drawing" />
                        <Button Content="⟲"
                                Click="ResetView_Click"
                                Style="{StaticResource InstitutionalGlassButton}"
                                Width="40" Height="34" Margin="10,0,10,0"
                                FontSize="14" FontWeight="Bold"
                                ToolTip="Reset view" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1"
                      Grid.Column="1"
                      Background="#0B0E13">
                    <wv2:WebView2 x:Name="ChartWebView"
                                  Margin="8,8,8,8"
                                  DefaultBackgroundColor="Transparent"
                                  NavigationCompleted="ChartWebView_NavigationCompleted" />
                </Grid>

                <Border Grid.Row="1"
                        Grid.Column="2"
                        Background="#0F131B"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Border Background="{StaticResource BuyColor}"
                                CornerRadius="3"
                                Padding="7,3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,14,0,0">
                            <TextBlock Text="{Binding CurrentPriceMarker}"
                                       Foreground="Black"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       FontWeight="Black" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="#0F131B"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1,0,0,0">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="EXCHANGE TERMINAL"
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   FontWeight="Black"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ChartFocusSummary}"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Text="WebView2 Chart Engine"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
