<UserControl x:Class="ThatsMyQuant.Dashboard.Views.PortfolioSunburstView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ThatsMyQuant.Dashboard.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PortfolioSunburstViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#0A1F2E">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="PORTFOLIO TREEMAP" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Hierarchical capital + PnL view: outermost band = market, middle = strategy family, inner = position. Tile size ∝ weight, color ∝ PnL."
                               Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Color by PnL" IsChecked="{Binding ShowPnlColors}" Foreground="{StaticResource TextSoft}" FontSize="10" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,2" FontSize="10"/>
                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource TextSoft}" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </Grid>

                    <Border Background="#0A1F2E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="2">
                        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding Tiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}" Stroke="{Binding Border}" StrokeThickness="1.5"
                                                       ToolTip="{Binding Title}"/>
                                            <TextBlock Canvas.Left="{Binding TitleX}" Canvas.Top="{Binding TitleY}"
                                                       Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Canvas.Left="{Binding SubtitleX}" Canvas.Top="{Binding SubtitleY}"
                                                       Text="{Binding Subtitle}" Foreground="#D8E3F0" FontSize="9"/>
                                            <TextBlock Canvas.Left="{Binding WeightX}" Canvas.Top="{Binding WeightY}"
                                                       Text="{Binding WeightLabel}" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Canvas.Left="{Binding PnlX}" Canvas.Top="{Binding PnlY}"
                                                       Text="{Binding PnlLabel}" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="10"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
