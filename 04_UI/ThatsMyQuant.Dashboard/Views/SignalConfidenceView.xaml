<UserControl x:Class="ThatsMyQuant.Dashboard.Views.SignalConfidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ThatsMyQuant.Dashboard.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SignalConfidenceViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#0A1F2E">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="SIGNAL CONFIDENCE RADAR" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Six-axis spider chart. Outward fill on all axes = ALL-IN. Refresh fetches recent candles and computes the six normalized [0,1] scores via Momentum/Trend/Volume/Volatility/Sentiment/AlphaTrend rules."
                               Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Symbol" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Symbol}" Width="120" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="TF" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="3" Text="{Binding Timeframe}" Width="48" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <Button Grid.Column="4" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,2" FontSize="10"/>
                        <TextBlock Grid.Column="5" Text="{Binding VerdictLabel}" Foreground="{Binding VerdictColor}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Radar Canvas -->
                        <Border Grid.Column="0" Background="#0A1F2E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="4">
                            <Canvas Width="{Binding CanvasSize}" Height="{Binding CanvasSize}" ClipToBounds="True">
                                <!-- Reference rings -->
                                <ItemsControl ItemsSource="{Binding RadarRings}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Polygon Points="{Binding Points}"
                                                     Stroke="#2A3B5E" StrokeThickness="0.7" Fill="Transparent"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Spokes -->
                                <ItemsControl ItemsSource="{Binding RadarSpokes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Polyline Points="{Binding Points}" Stroke="#2A3B5E" StrokeThickness="0.6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Value polygon -->
                                <Polygon Points="{Binding ValuePolygon}"
                                         Fill="#5037A95B" Stroke="#37A95B" StrokeThickness="2"/>
                                <!-- Value vertex dots -->
                                <ItemsControl ItemsSource="{Binding ValueDots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="8" Height="8" Fill="#37A95B" Stroke="#0A1F2E" StrokeThickness="1.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style>
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                                <!-- Axis labels -->
                                <ItemsControl ItemsSource="{Binding RadarLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Foreground="#8B949E" FontSize="10" FontWeight="Bold" Width="60" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style>
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </Canvas>
                        </Border>

                        <!-- Score breakdown -->
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="SCORE BREAKDOWN" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Momentum" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ScoreMomentum, Mode=OneWay}" Height="8" Foreground="#37A95B" Background="#1A2C44" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ScoreMomentum, StringFormat={}{0:P0}}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Trend Strength" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ScoreTrendStrength, Mode=OneWay}" Height="8" Foreground="#37A95B" Background="#1A2C44" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ScoreTrendStrength, StringFormat={}{0:P0}}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Volume Ratio" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ScoreVolumeRatio, Mode=OneWay}" Height="8" Foreground="#37A95B" Background="#1A2C44" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ScoreVolumeRatio, StringFormat={}{0:P0}}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Volatility" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ScoreVolatility, Mode=OneWay}" Height="8" Foreground="#37A95B" Background="#1A2C44" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ScoreVolatility, StringFormat={}{0:P0}}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sentiment" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ScoreSentiment, Mode=OneWay}" Height="8" Foreground="#37A95B" Background="#1A2C44" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ScoreSentiment, StringFormat={}{0:P0}}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AlphaTrend" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ScoreAlphaTrendAlignment, Mode=OneWay}" Height="8" Foreground="#37A95B" Background="#1A2C44" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ScoreAlphaTrendAlignment, StringFormat={}{0:P0}}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
