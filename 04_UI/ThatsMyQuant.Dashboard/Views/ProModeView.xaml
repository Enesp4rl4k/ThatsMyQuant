<UserControl x:Class="ThatsMyQuant.Dashboard.Views.ProModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBg}"
             Foreground="{StaticResource TextMain}"
             FontFamily="{StaticResource PrimaryFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0">

            <!-- Control Bar -->
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="🛡️ PRO MODE — Level 2.5 (Phase A)" FontSize="15" FontWeight="Black" Foreground="{StaticResource TextMain}"/>
                        <TextBlock Text="Regime-aware leverage + opportunity scanner + circuit breaker + candidate pool with 7-day OOS gate. Monitoring only in Phase A — candidates require manual promotion to execution. Kill switch arms instantly on click."
                                   Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,8" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,4,0,0">
                            <Run Text="Last scan: "/>
                            <Run Text="{Binding LastScanUtc, StringFormat={}{0:HH:mm:ss} UTC}"/>
                            <Run Text=" · scans="/>
                            <Run Text="{Binding ScanCount}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,12,0" Width="170">
                                <TextBlock Text="BASE LEVERAGE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                <Slider Minimum="1" Maximum="15" Value="{Binding BaseLeverage, Mode=TwoWay}"
                                        TickPlacement="BottomRight" TickFrequency="1" SmallChange="0.5"
                                        Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="{Binding BaseLeverage, StringFormat={}{0:F1}x (hard cap 15x)}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ARM" Command="{Binding ArmCommand}"
                                    Background="{StaticResource Accent}" Foreground="White"
                                    FontSize="10" FontWeight="Black" BorderThickness="0" Padding="14,8" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsArmed, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="DISARM" Command="{Binding DisarmCommand}"
                                    Background="{StaticResource SurfaceBg}" Foreground="{StaticResource TextMain}"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    FontSize="10" FontWeight="Bold" Padding="14,8" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsArmed}"/>
                            <Button Content="FORCE SCAN" Command="{Binding ForceScanCommand}"
                                    Background="{StaticResource SurfaceBg}" Foreground="{StaticResource Accent}"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    FontSize="10" FontWeight="Bold" Padding="14,8" Margin="0,0,8,0"/>
                            <Button Content="🛑 KILL" Command="{Binding EmergencyKillCommand}"
                                    Background="#F05A5A" Foreground="White"
                                    FontSize="10" FontWeight="Black" BorderThickness="0" Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Strip -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PRO MODE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="{Binding IsArmed, StringFormat={}{0}}" FontSize="20" FontWeight="Black" Margin="0,4,0,0" Foreground="{StaticResource Accent}" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Text="{Binding LeverageExplanation}" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CIRCUIT BREAKER" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CircuitBreakerStateText}" FontSize="20" FontWeight="Black" Margin="0,4,0,0" Foreground="{Binding CircuitBreakerStateColor}" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,6,0,0" TextWrapping="Wrap">
                            <Run Text="Realised DD: "/>
                            <Run Text="{Binding RealizedDrawdown, StringFormat={}{0:P2}}"/>
                            <Run Text="  · trip @ 5%"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MARKET REGIME" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RegimeText}" FontSize="20" FontWeight="Black" Margin="0,4,0,0" Foreground="{Binding RegimeColor}" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Text="Volatile → leverage halved" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TerminalCardStyle}">
                    <StackPanel>
                        <TextBlock Text="EFFECTIVE LEVERAGE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="{Binding EffectiveLeverage, StringFormat={}{0:F1}x}" FontSize="20" FontWeight="Black" Margin="0,4,0,0" Foreground="{StaticResource Accent}" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,6,0,0" TextWrapping="Wrap">
                            <Run Text="Base: "/>
                            <Run Text="{Binding BaseLeverage, StringFormat={}{0:F1}x}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Opportunity Feed -->
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="LIVE OPPORTUNITY FEED (funding ≥ 1.5bp · high-conviction ≥ 3bp)"
                               Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Opportunities}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                              GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#0A2A3B5E"
                              MaxHeight="200" ColumnHeaderHeight="28" RowHeight="26"
                              Foreground="{StaticResource TextMain}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding ObservedUtc, StringFormat={}{0:HH:mm:ss}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SYMBOL" Binding="{Binding Symbol}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="FUNDING (bp/8h)" Binding="{Binding FundingBps, StringFormat={}{0:+0.00;-0.00;0.00}}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding ConvictionColor}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DIRECTION" Binding="{Binding Direction}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding ConvictionColor}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CONVICTION" Binding="{Binding Conviction}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding ConvictionColor}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Stress Test Panel -->
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STRESS TEST — DEFENSE STACK READINESS"
                                   Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="RUN STRESS TEST" Command="{Binding RunStressTestCommand}"
                                Background="{StaticResource SurfaceBg}" Foreground="{StaticResource Accent}"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                FontSize="10" FontWeight="Bold" Padding="12,6"
                                IsEnabled="{Binding IsRunningStressTest, Converter={StaticResource InverseBooleanConverter}}"/>
                    </Grid>
                    <TextBlock Text="{Binding StressTestReport}" Foreground="{Binding StressTestColor}"
                               FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}"/>
                </StackPanel>
            </Border>

            <!-- Candidate Pool -->
            <Border Style="{StaticResource TerminalCardStyle}">
                <StackPanel>
                    <TextBlock Text="CANDIDATE POOL — PROMOTION GATE (7d obs · PF ≥ 1.15 · Sharpe ≥ 1.0 · trades ≥ 10)"
                               Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                              GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#0A2A3B5E"
                              MaxHeight="220" ColumnHeaderHeight="28" RowHeight="26"
                              Foreground="{StaticResource TextMain}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SYMBOL" Binding="{Binding Symbol}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="STRATEGY" Binding="{Binding StrategyTag}" Width="130"/>
                            <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding StateColor}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SIGNALS" Binding="{Binding Observations}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="OOS SHARPE" Binding="{Binding OosSharpe, StringFormat={}{0:F2}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="OOS PF" Binding="{Binding OosProfitFactor, StringFormat={}{0:F2}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="REASON / NOTE" Binding="{Binding Reason}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="FontSize" Value="10"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
