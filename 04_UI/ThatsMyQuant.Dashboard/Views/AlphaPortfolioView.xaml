<UserControl x:Class="ThatsMyQuant.Dashboard.Views.AlphaPortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource AppBg}"
             Foreground="{StaticResource TextMain}"
             FontFamily="{StaticResource PrimaryFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0">

            <!-- Header / Action Bar -->
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ALPHA PORTFOLIO" FontSize="15" FontWeight="Black" Foreground="{StaticResource TextMain}" />
                        <TextBlock Text="Validated 4-position combined portfolio — TRX/XLM pair + LTC/DOGE/AAVE funding alpha. 2026-04-24 combined backtest achieved Sharpe 3.87 with DD 0.19% and correlation 0.130."
                                   Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="RISK PROFILE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableRiskProfiles}"
                                          SelectedItem="{Binding SelectedRiskProfile, Mode=TwoWay}" Width="150"
                                          Background="{StaticResource AppBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0" Width="200">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LEVERAGE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Leverage, StringFormat={}{0:F1}x}" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                                </Grid>
                                <Slider Minimum="1" Maximum="15" SmallChange="0.5" LargeChange="1"
                                        Value="{Binding Leverage, Mode=TwoWay}"
                                        TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="False"
                                        Foreground="{StaticResource Accent}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="CAPITAL" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TotalCapital, StringFormat={}{0:N0}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" Background="{StaticResource AppBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}"
                                         Padding="6,4" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="DAYS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BacktestDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60" Background="{StaticResource AppBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}"
                                         Padding="6,4" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding LeverageLabel}" Foreground="{Binding LeverageLabelColor}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="RUN PORTFOLIO BACKTEST" Command="{Binding RunBacktestCommand}"
                                    Background="{StaticResource Accent}" Foreground="White"
                                    FontSize="10" FontWeight="Black" BorderThickness="0" Padding="14,8" Margin="0,0,12,0"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="LAUNCH PAPER TRADE" Command="{Binding PaperTradeLaunchCommand}"
                                    Background="{StaticResource SurfaceBg}" Foreground="{StaticResource Accent}"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    FontSize="10" FontWeight="Black" Padding="14,8" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsPaperWorkerRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="STOP PAPER" Command="{Binding PaperTradeStopCommand}"
                                    Background="{StaticResource SurfaceBg}" Foreground="#F05A5A"
                                    BorderBrush="#F05A5A" BorderThickness="1"
                                    FontSize="10" FontWeight="Black" Padding="14,8"
                                    IsEnabled="{Binding IsPaperWorkerRunning}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PaperWorkerStatus, StringFormat=Worker: {0}}"
                                   Foreground="{Binding PaperWorkerStatusColor}"
                                   FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"
                                   FontFamily="{StaticResource MonoFont}"/>
                        <ProgressBar Height="4" IsIndeterminate="{Binding IsRunning}" Margin="0,8,0,0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Aggregate KPI Cards -->
            <UniformGrid Columns="5" Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PORTFOLIO SHARPE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding PortfolioSharpe, StringFormat={}{0:F2}}" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Black"
                                   Foreground="{Binding PortfolioSharpe, Converter={StaticResource SharpeToColorConverter}}" Margin="0,4,0,0"/>
                        <TextBlock Text="&gt;3 elite · &gt;2 pro · &gt;1 good" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="NET PnL" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding PortfolioPnl, StringFormat={}{0:N2}}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black"
                                   Foreground="{Binding PortfolioPnl, Converter={StaticResource PnlToColorConverter}}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding PortfolioPnlPct, StringFormat=RETURN {0:P2}}" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MAX DRAWDOWN" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding PortfolioMaxDrawdown, StringFormat={}{0:P2}}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black"
                                   Foreground="{Binding PortfolioMaxDrawdown, Converter={StaticResource DrawdownToColorConverter}}" Margin="0,4,0,0"/>
                        <TextBlock Text="&lt;1% excellent · &lt;5% pro" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="AVG CORRELATION" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding PortfolioAvgCorrelation, StringFormat={}{0:F3}}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black"
                                   Foreground="{StaticResource Accent}" Margin="0,4,0,0"/>
                        <TextBlock Text="≤0.3 true diversification" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TerminalCardStyle}">
                    <StackPanel>
                        <TextBlock Text="FINAL EQUITY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding PortfolioFinalEquity, StringFormat={}{0:N0}}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black"
                                   Foreground="{StaticResource TextMain}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding PortfolioTradingDays, StringFormat=DAYS {0}}" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Position Table -->
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="POSITIONS (Kelly-weighted)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Positions}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                              GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#0A2A3B5E"
                              ColumnHeaderHeight="28" RowHeight="36"
                              Foreground="{StaticResource TextMain}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SYMBOLS" Binding="{Binding SymbolDisplay}" Width="170"/>
                            <DataGridTextColumn Header="TF" Binding="{Binding Timeframe}" Width="50"/>
                            <DataGridTextColumn Header="WEIGHT" Binding="{Binding WeightDisplay}" Width="70"/>
                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="130"/>
                            <DataGridTextColumn Header="TRADES" Binding="{Binding ActualTrades}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="WR" Binding="{Binding ActualWinRate, StringFormat={}{0:P1}}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SHARPE" Binding="{Binding ActualSharpe, StringFormat={}{0:F2}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="Foreground" Value="{Binding ActualSharpe, Converter={StaticResource SharpeToColorConverter}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PnL" Binding="{Binding ActualPnl, StringFormat={}{0:N2}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="Foreground" Value="{Binding ActualPnl, Converter={StaticResource PnlToColorConverter}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PF" Binding="{Binding ActualProfitFactor, StringFormat={}{0:F2}}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DD" Binding="{Binding ActualMaxDrawdown, StringFormat={}{0:P2}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Equity Curve + Drawdown (Polyline based, no external dep) -->
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="EQUITY CURVE &amp; DRAWDOWN" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="10" Height="3" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Equity" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="3" Fill="#F05A5A" VerticalAlignment="Center"/>
                                <TextBlock Text="Drawdown ×20" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border Background="#0A1F2E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="4">
                        <Canvas Height="{Binding EquityCanvasHeight}" Width="{Binding EquityCanvasWidth}" ClipToBounds="True">
                            <Polyline Points="{Binding EquityCurvePoints}" Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                            <Polyline Points="{Binding DrawdownCurvePoints}" Stroke="#F05A5A" StrokeThickness="1.2" Opacity="0.85"/>
                        </Canvas>
                    </Border>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding EquityChartDateRange}" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                        <TextBlock Grid.Column="1" Foreground="{StaticResource TextMuted}" FontSize="9">
                            <Run Text="Y-range: "/>
                            <Run Text="{Binding EquityChartYLabel}"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Daily PnL Distribution Histogram -->
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="DAILY PnL DISTRIBUTION" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding PnlHistogramSummary}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Border Background="#0A1F2E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="4">
                        <ItemsControl ItemsSource="{Binding PnlHistogram}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding PnlHistogramWidth}" Height="{Binding PnlHistogramHeight}" ClipToBounds="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding BarColor}"
                                               ToolTip="{Binding Count, StringFormat={}{0} days}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Underwater Plot (drawdown depth, fund-manager style) -->
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="UNDERWATER PLOT" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding UnderwaterSummary}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Border Background="#0A1F2E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="4">
                        <Canvas Height="{Binding UnderwaterCanvasHeight}" Width="{Binding UnderwaterCanvasWidth}" ClipToBounds="True">
                            <!-- Filled drawdown area (red, semi-transparent) -->
                            <Polygon Points="{Binding UnderwaterAreaPoints}"
                                     Fill="#40F05A5A" Stroke="#F05A5A" StrokeThickness="1.2"/>
                            <!-- Zero line -->
                            <Polyline Points="{Binding UnderwaterZeroLinePoints}"
                                      Stroke="#8B949E" StrokeThickness="1" StrokeDashArray="3,3"/>
                            <!-- Max DD label -->
                            <Border Canvas.Left="{Binding UnderwaterMaxDdLabelX}"
                                    Canvas.Top="{Binding UnderwaterMaxDdLabelY}"
                                    Background="#15F05A5A" BorderBrush="#F05A5A" BorderThickness="1"
                                    CornerRadius="2" Padding="4,1">
                                <TextBlock Text="{Binding UnderwaterMaxDdLabel}"
                                           Foreground="#F05A5A" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </Canvas>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Monte Carlo Fan Chart (forward projection) -->
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MONTE CARLO FAN" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Days" Foreground="{StaticResource TextSoft}" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="2" Text="{Binding McFanProjectionDays}" Width="48" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="3" Text="Iter" Foreground="{StaticResource TextSoft}" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="4" Text="{Binding McFanIterations}" Width="60" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <Button Grid.Column="5" Content="Project Fan" Command="{Binding RunMonteCarloFanCommand}" Padding="10,2" FontSize="10"/>
                    </Grid>
                    <TextBlock Text="{Binding McFanStatus}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding McFanSummary}" Foreground="{StaticResource TextSoft}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding McFanHasResults, Converter={StaticResource BoolToVis}}"/>
                    <Border Background="#0A1F2E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="4"
                            Visibility="{Binding McFanHasResults, Converter={StaticResource BoolToVis}}">
                        <Canvas Height="{Binding McFanCanvasHeight}" Width="{Binding McFanCanvasWidth}" ClipToBounds="True">
                            <!-- Outer envelope P5-P95 (faint) -->
                            <Polygon Points="{Binding McFanP5to95Polygon}"
                                     Fill="#2037A95B" Stroke="#4037A95B" StrokeThickness="0.5"/>
                            <!-- Inner envelope P25-P75 (denser) -->
                            <Polygon Points="{Binding McFanP25to75Polygon}"
                                     Fill="#5037A95B" Stroke="#8037A95B" StrokeThickness="0.5"/>
                            <!-- Median path -->
                            <Polyline Points="{Binding McFanMedianLine}"
                                      Stroke="#37A95B" StrokeThickness="2"/>
                            <!-- "Today" reference horizontal -->
                            <Polyline Points="{Binding McFanRealizedLine}"
                                      Stroke="#F0883E" StrokeThickness="1" StrokeDashArray="4,3"/>
                        </Canvas>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding McFanHasResults, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="10" Height="3" Fill="#37A95B" VerticalAlignment="Center"/>
                        <TextBlock Text="Median" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,16,0"/>
                        <Rectangle Width="10" Height="10" Fill="#5037A95B" VerticalAlignment="Center"/>
                        <TextBlock Text="P25-P75 (50% conf.)" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,16,0"/>
                        <Rectangle Width="10" Height="10" Fill="#2037A95B" VerticalAlignment="Center"/>
                        <TextBlock Text="P5-P95 (90% conf.)" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,16,0"/>
                        <Rectangle Width="10" Height="2" Fill="#F0883E" VerticalAlignment="Center"/>
                        <TextBlock Text="Today (start)" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Correlation Heatmap -->
            <Border Style="{StaticResource TerminalCardStyle}" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="CORRELATION MATRIX" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Daily-return Pearson correlation between strategies. Green ≤0.30 = true diversification. Yellow 0.30–0.60. Red ≥0.60 = crowded."
                               Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding CorrelationRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RowName}" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Values}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BackgroundBrush}" CornerRadius="3" Margin="2" Height="28" ToolTip="{Binding ColumnName}">
                                                    <TextBlock Text="{Binding Value, StringFormat={}{0:F3}}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
