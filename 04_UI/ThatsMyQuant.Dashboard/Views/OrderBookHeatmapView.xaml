<UserControl x:Class="ThatsMyQuant.Dashboard.Views.OrderBookHeatmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ThatsMyQuant.Dashboard.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:OrderBookHeatmapViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#0A1F2E">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ORDER BOOK HEATMAP" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="L2 depth visualisation. Bar length = resting size at level. Color intensity goes blue→yellow on bid side and red→yellow on ask side; bright yellow = liquidity wall."
                               Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Symbol" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Symbol}" Width="120" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="Depth" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="3" Text="{Binding DepthLevels}" Width="48" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="4" Text="Poll(ms)" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="5" Text="{Binding PollMs}" Width="60" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <Button Grid.Column="6" Content="Start" Command="{Binding StartCommand}" Padding="10,2" FontSize="10" Margin="0,0,4,0"/>
                        <Button Grid.Column="7" Content="Stop" Command="{Binding StopCommand}" Padding="10,2" FontSize="10" Margin="0,0,4,0"/>
                        <Button Grid.Column="8" Content="Tick" Command="{Binding RefreshOnceCommand}" Padding="10,2" FontSize="10" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="9" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BEST BID" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                            <TextBlock Text="{Binding BestBidLabel}" Foreground="#37A95B" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BEST ASK" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                            <TextBlock Text="{Binding BestAskLabel}" Foreground="#F05A5A" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SPREAD" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                            <TextBlock Text="{Binding SpreadLabel}" Foreground="#F0883E" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="ORDER FLOW IMBALANCE" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                            <TextBlock Text="{Binding ImbalanceLabel}" Foreground="{Binding ImbalanceColor}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#0A1F2E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="2">
                        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" ClipToBounds="True">
                            <!-- Bid bars -->
                            <ItemsControl ItemsSource="{Binding BidCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                                       Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"
                                                       ToolTip="{Binding QtyLabel}"/>
                                            <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                       Text="{Binding PriceLabel}" Foreground="#D8E3F0" FontFamily="{StaticResource MonoFont}" FontSize="9"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Ask bars -->
                            <ItemsControl ItemsSource="{Binding AskCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                                       Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"
                                                       ToolTip="{Binding QtyLabel}"/>
                                            <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                       Text="{Binding PriceLabel}" Foreground="#D8E3F0" FontFamily="{StaticResource MonoFont}" FontSize="9"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
