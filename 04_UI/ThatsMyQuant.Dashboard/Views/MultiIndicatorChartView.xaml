<UserControl x:Class="ThatsMyQuant.Dashboard.Views.MultiIndicatorChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ThatsMyQuant.Dashboard.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MultiIndicatorChartViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#0A1F2E">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>
            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="MULTI-INDICATOR TECHNICAL CHART" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Candles + AlphaTrend (ATR ±1.5σ band) + PMax (ATR trailing stop) + EMA-21 + S/R pivots + buy/sell markers. Pure WPF Canvas — no external charting library."
                               Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Symbol" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Symbol}" Width="120" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="TF" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="3" Text="{Binding Timeframe}" Width="48" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="4" Text="Bars" Foreground="{StaticResource TextSoft}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="5" Text="{Binding Bars}" Width="48" Height="22" FontSize="10" Margin="0,0,8,0"/>
                        <Button Grid.Column="6" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,2" FontSize="10"/>
                        <TextBlock Grid.Column="7" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="AlphaTrend" IsChecked="{Binding ShowAlphaTrend}" Foreground="{StaticResource TextSoft}" FontSize="10" Margin="0,0,12,0"/>
                        <CheckBox Content="PMax" IsChecked="{Binding ShowPmax}" Foreground="{StaticResource TextSoft}" FontSize="10" Margin="0,0,12,0"/>
                        <CheckBox Content="EMA-21" IsChecked="{Binding ShowEma}" Foreground="{StaticResource TextSoft}" FontSize="10" Margin="0,0,12,0"/>
                        <CheckBox Content="S/R Pivots" IsChecked="{Binding ShowSrBands}" Foreground="{StaticResource TextSoft}" FontSize="10" Margin="0,0,12,0"/>
                        <CheckBox Content="Markers" IsChecked="{Binding ShowMarkers}" Foreground="{StaticResource TextSoft}" FontSize="10"/>
                    </StackPanel>

                    <Border Background="#0A1F2E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="2">
                        <Canvas Width="{Binding ChartCanvasWidth}" Height="{Binding ChartCanvasHeight}" ClipToBounds="True">
                            <!-- S/R bands first so they sit beneath candles -->
                            <ItemsControl ItemsSource="{Binding SrBands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding BandFill}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <!-- S/R band labels -->
                            <ItemsControl ItemsSource="{Binding SrBands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Foreground="#F0883E" FontFamily="{StaticResource MonoFont}" FontSize="9"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left" Value="{Binding LabelX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding LabelY}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <!-- Candles -->
                            <ItemsControl ItemsSource="{Binding Candles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Line X1="{Binding WickX1}" Y1="{Binding WickY1}" X2="{Binding WickX2}" Y2="{Binding WickY2}"
                                                  Stroke="{Binding StrokeBrush}" StrokeThickness="1"/>
                                            <Rectangle Canvas.Left="{Binding BodyX}" Canvas.Top="{Binding BodyY}"
                                                       Width="{Binding BodyWidth}" Height="{Binding BodyHeight}"
                                                       Fill="{Binding FillBrush}" Stroke="{Binding StrokeBrush}" StrokeThickness="0.6"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- AlphaTrend bands -->
                            <Polyline Points="{Binding AlphaTrendUpper}" Stroke="#9F37D2" StrokeThickness="1" Opacity="0.85" StrokeDashArray="3,2"/>
                            <Polyline Points="{Binding AlphaTrendLower}" Stroke="#9F37D2" StrokeThickness="1" Opacity="0.85" StrokeDashArray="3,2"/>
                            <!-- PMax -->
                            <Polyline Points="{Binding PmaxLine}" Stroke="#F0883E" StrokeThickness="1.5"/>
                            <!-- EMA -->
                            <Polyline Points="{Binding EmaLine}" Stroke="#37A9FF" StrokeThickness="1.5"/>

                            <!-- Markers -->
                            <ItemsControl ItemsSource="{Binding Markers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <TextBlock Canvas.Left="{Binding ArrowX}" Canvas.Top="{Binding ArrowY}"
                                                       Text="{Binding ArrowSymbol}" Foreground="{Binding ArrowFill}" FontSize="14" FontWeight="Bold"/>
                                            <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                    Background="#150A1F2E" BorderBrush="{Binding ArrowFill}" BorderThickness="1" CornerRadius="2" Padding="3,1">
                                                <TextBlock Text="{Binding LabelText}" Foreground="{Binding ArrowFill}" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Price axis -->
                            <ItemsControl ItemsSource="{Binding PriceAxisLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="#8B949E" FontFamily="{StaticResource MonoFont}" FontSize="9"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <!-- Time axis -->
                            <ItemsControl ItemsSource="{Binding TimeAxisLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="#8B949E" FontFamily="{StaticResource MonoFont}" FontSize="9"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Canvas>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Rectangle Width="10" Height="3" Fill="#9F37D2" VerticalAlignment="Center"/>
                        <TextBlock Text="AlphaTrend" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,12,0"/>
                        <Rectangle Width="10" Height="3" Fill="#F0883E" VerticalAlignment="Center"/>
                        <TextBlock Text="PMax" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,12,0"/>
                        <Rectangle Width="10" Height="3" Fill="#37A9FF" VerticalAlignment="Center"/>
                        <TextBlock Text="EMA-21" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,12,0"/>
                        <Rectangle Width="10" Height="6" Fill="#40F05A5A" VerticalAlignment="Center"/>
                        <TextBlock Text="Resistance" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,12,0"/>
                        <Rectangle Width="10" Height="6" Fill="#4037A95B" VerticalAlignment="Center"/>
                        <TextBlock Text="Support" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="6,0,12,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
