<Window x:Class="ThatsMyQuant.Dashboard.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ThatsMyQuant.Dashboard.Converters"
        Title="Change Password" Width="420" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBg}"
        Foreground="{StaticResource TextMain}"
        FontFamily="{StaticResource PrimaryFont}">
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>

    <Border Margin="16"
            Padding="24"
            CornerRadius="12"
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1AFFFFFF" Offset="0"/>
                <GradientStop Color="#05FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#2AFFFFFF" />
        </Border.BorderBrush>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Rotate Operator Credential"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />
            <TextBlock Text="Set a new password for the current operator account."
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,0,0,20" />

            <TextBlock Text="New Password" Margin="0,0,0,6" />
            <PasswordBox x:Name="NewPasswordBox"
                         Height="42"
                         Margin="0,0,0,14"
                         Background="#0AFFFFFF"
                         BorderBrush="#2AFFFFFF"
                         BorderThickness="1"
                         Foreground="White"
                         Padding="12,0"
                         VerticalContentAlignment="Center" />

            <TextBlock Text="Confirm Password" Margin="0,0,0,6" />
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="42"
                         Margin="0,0,0,16"
                         Background="#0AFFFFFF"
                         BorderBrush="#2AFFFFFF"
                         BorderThickness="1"
                         Foreground="White"
                         Padding="12,0"
                         VerticalContentAlignment="Center" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource SellColor}"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Submit"
                        Command="{Binding SubmitCommand}"
                        Width="96"
                        Height="36"
                        Margin="0,0,10,0" />
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="96"
                        Height="36" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
