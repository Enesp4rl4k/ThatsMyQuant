<UserControl x:Class="ThatsMyQuant.Dashboard.Controls.BacktestReportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ThatsMyQuant.Dashboard.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#0D0D12">

    <UserControl.Resources>
        <!-- Premium Colors -->
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#16161E"/>
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#3D5AFE"/>
        <SolidColorBrush x:Key="WinGreenBrush" Color="#00E676"/>
        <SolidColorBrush x:Key="LossRedBrush" Color="#FF1744"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1E1E2A"/>
        <SolidColorBrush x:Key="RowAltBrush" Color="#1A1A25"/>

        <!-- Premium Button Style -->
        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252535"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3D5AFE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Summary Cards Row 1 -->
            <RowDefinition Height="Auto"/>  <!-- Summary Cards Row 2 -->
            <RowDefinition Height="*"/>     <!-- Results Table -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="BACKTEST ANALYTICS LAB" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Full performance verification with PBO overfitting analysis" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="REFRESH DATA" Command="{Binding RefreshBacktestCommand}" Style="{StaticResource AccentButtonStyle}" Margin="8,0"/>
                <Button Content="EXPORT CSV" Command="{Binding ExportBacktestCsvCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- METRICS ROW 1 — Key Performance -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
            <Border Margin="4" Padding="14" Background="{StaticResource CardBgBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="TOTAL SESSIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding BacktestBuckets.Count}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="{StaticResource CardBgBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="CUMULATIVE PNL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding CumulativePnL, StringFormat=N2}" FontSize="22" FontWeight="Bold"
                               Foreground="{Binding CumulativePnL, Converter={StaticResource PnlToColorConverter}}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="{StaticResource CardBgBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="TOP PROFIT FACTOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TopProfitFactor, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WinGreenBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="{StaticResource CardBgBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="PROMOTION READY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PromotionReadyCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- METRICS ROW 2 — Risk & Quality -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,16">
            <Border Margin="4" Padding="14" Background="{StaticResource CardBgBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="BEST SHARPE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding BestSharpeRatio, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="#64B5F6" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="{StaticResource CardBgBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="BEST SORTINO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding BestSortinoRatio, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="#CE93D8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="{StaticResource CardBgBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="AVG MAX DRAWDOWN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AvgMaxDrawdown, StringFormat={}{0:N2}%}" FontSize="22" FontWeight="Bold" Foreground="#FFB74D" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14" Background="{StaticResource CardBgBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="AVG WIN RATE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AvgWinRate, StringFormat={}{0:P1}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WinGreenBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- DATA GRID — Full Results Table -->
        <Border Grid.Row="3" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="8" Padding="12">
            <DataGrid ItemsSource="{Binding BacktestBuckets}" AutoGenerateColumns="False"
                      Background="Transparent" BorderThickness="0" Foreground="White" RowBackground="Transparent"
                      AlternatingRowBackground="#1A1A25"
                      CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      HeadersVisibility="Column" RowHeight="38"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizationMode="Recycling" />
                    </ItemsPanelTemplate>
                </DataGrid.ItemsPanel>
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#252535"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="BorderBrush" Value="#2A2A3A"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#1E1E2E"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Time & Identity -->
                    <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding RecordedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="SYMBOL" Binding="{Binding Symbol}" Width="90"/>
                    <DataGridTextColumn Header="STRATEGY" Binding="{Binding StrategyTag}" Width="110"/>

                    <!-- Trade Stats -->
                    <DataGridTextColumn Header="TRADES" Binding="{Binding Trades}" Width="65"/>

                    <DataGridTemplateColumn Header="WIN RATE" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WinRate, StringFormat=P1}"
                                           Foreground="{Binding WinRate, Converter={StaticResource WinRateToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PF" Binding="{Binding ProfitFactor, StringFormat=N2}" Width="60"/>

                    <!-- PnL & Equity -->
                    <DataGridTemplateColumn Header="NET PNL" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalPnL, StringFormat=N2}" FontWeight="SemiBold"
                                           Foreground="{Binding TotalPnL, Converter={StaticResource PnlToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="CAPITAL" Binding="{Binding StartingCapital, StringFormat=N0}" Width="85"/>
                    <DataGridTextColumn Header="FINAL EQ" Binding="{Binding FinalEquity, StringFormat=N0}" Width="85"/>

                    <!-- Risk Metrics -->
                    <DataGridTemplateColumn Header="SHARPE" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SharpeRatio, StringFormat=N2}"
                                           Foreground="{Binding SharpeRatio, Converter={StaticResource SharpeToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="SORTINO" Binding="{Binding SortinoRatio, StringFormat=N2}" Width="70"/>

                    <DataGridTemplateColumn Header="MAX DD" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MaxDrawdownPercent, StringFormat={}{0:N2}%}"
                                           Foreground="{Binding MaxDrawdownPercent, Converter={StaticResource DrawdownToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="AVG RR" Binding="{Binding AverageRR, StringFormat=N2}" Width="65"/>
                    <DataGridTextColumn Header="MAX LOSS STREAK" Binding="{Binding MaxConsecutiveLosses}" Width="110"/>

                    <!-- PBO Overfitting -->
                    <DataGridTemplateColumn Header="PBO" Width="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PboScore, StringFormat=N2}"
                                           Foreground="{Binding PboScore, Converter={StaticResource PboToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BacktestPass, Converter={StaticResource PassToBrushConverter}}"
                                        CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding PromotionStage}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PAPER REASON" Binding="{Binding PaperPromotionSummary}" Width="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
