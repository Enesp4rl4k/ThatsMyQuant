                                        <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" Padding="12" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="VISUAL EDGE ANALYSIS" FontSize="11" FontWeight="Black" Foreground="{StaticResource TextMain}" />
                                                <TextBlock Text="Review entry/exit confluence quality and strategy-regime alignment per historical candle." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MarketOverview.ChartHeaderTitle}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource TerminalCardStyle}" Background="{StaticResource AppBg}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /> <!-- Selected Trade Registry -->
                                            <RowDefinition Height="Auto" /> <!-- Global Results Header -->
                                            <RowDefinition Height="*" />    <!-- Global Results Grid -->
                                        </Grid.RowDefinitions>
                                        
                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="SELECTED TRADE REGISTRY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,10" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                                <ItemsControl ItemsSource="{Binding Studio.BacktestTrades}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10" Margin="0,0,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Side}" Foreground="{Binding Color}" FontSize="10" FontWeight="Black" />
                                                                            <TextBlock Text="{Binding Confidence, StringFormat={}({0}%)}" Foreground="{StaticResource TextSoft}" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding ExitTime, StringFormat={}{0:dd MMM HH:mm}}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMuted}" FontSize="8" />
                                                                    </StackPanel>
