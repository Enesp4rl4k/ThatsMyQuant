                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="RISK PROFILE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <ComboBox ItemsSource="{Binding Studio.RiskProfiles}" SelectedItem="{Binding Studio.SelectedRiskProfile}" Background="{StaticResource AppBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                    <TextBlock Text="TRADE TARGET MODE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <ComboBox ItemsSource="{Binding Studio.TradeTargetModes}" SelectedItem="{Binding Studio.SelectedTradeTargetMode}" Background="{StaticResource AppBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding ActiveTradeTarget}" Foreground="{StaticResource TextMain}" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding TradeTargetDiscoveryStatus}" Foreground="{StaticResource TextSoft}" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                        <TextBlock Text="POSITION RISK STATUS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="{Binding AiAnalystView.TraderSafetyStatus}" Foreground="{Binding AiAnalystView.TraderSafetyColor}" FontSize="15" FontWeight="Black" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding AiAnalystView.AiTradeRecommendation}" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AiAnalystView.AiRiskSummary}" Foreground="{StaticResource TextSoft}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="EXECUTION FUNCTIONS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                        <UniformGrid Columns="2" Margin="0,6,0,10">
                            <Button Style="{StaticResource DeckActionButtonAccentStyle}" Content="INITIALIZE BOT" Command="{Binding StartTradingCommand}" IsEnabled="{Binding CanExecuteTrades}" Margin="0,0,6,8" />
                            <Button Style="{StaticResource DeckActionButtonStyle}" Content="RUN SCAN" Command="{Binding RefreshAnalysisCommand}" Margin="6,0,0,8" />
                            <Button Style="{StaticResource DeckActionButtonStyle}" Content="LOCAL BACKTEST" Command="{Binding RunBacktestCommand}" Margin="0,0,6,8" />
                            <Button Style="{StaticResource DeckActionButtonStyle}" Content="GLOBAL BACKTEST" Command="{Binding RunGlobalBacktestCommand}" Margin="6,0,0,8" />
                            <Button Style="{StaticResource DeckActionButtonStyle}" Content="CALIBRATE AI" Command="{Binding CalibrateAiCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource DeckActionButtonStyle}" Content="VERIFY LINKS" Command="{Binding VerifyConnectionCommand}" Margin="6,0,0,0" />
                        </UniformGrid>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="REFRESH" Command="{Binding RefreshAnalysisCommand}" Background="{StaticResource SurfaceBg}" Foreground="{StaticResource TextMain}" FontSize="10" FontWeight="Bold" BorderBrush="{StaticResource BorderColor}" Padding="0,10" Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="LIVE / PAPER" Command="{Binding ToggleTradingModeCommand}" Background="{StaticResource SurfaceBg}" Foreground="{StaticResource TextMain}" FontSize="10" FontWeight="Bold" BorderBrush="{StaticResource BorderColor}" Padding="0,10" Margin="4,0,0,0" />
                        </Grid>

                        <TextBlock Text="OPERATIONS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                        <UniformGrid Columns="2" Margin="0,6,0,10">
                            <Button Style="{StaticResource DeckActionButtonStyle}" Content="EXPORT LEDGER" Command="{Binding ExportLedgerCommand}" Margin="0,0,6,8" />
                            <Button Style="{StaticResource DeckActionButtonStyle}" Content="SAVE SETTINGS" Command="{Binding SaveSettingsCommand}" Margin="6,0,0,8" />
                            <Button Style="{StaticResource DeckActionButtonStyle}" Content="CLOSE ALL" Command="{Binding CloseAllPositionsCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource DeckActionButtonStyle}" Content="RESET RISK" Command="{Binding ResetKillSwitchCommand}" Margin="6,0,0,0" />
                        </UniformGrid>

                        <Button Content="EMERGENCY SHUTDOWN" Command="{Binding EmergencyStopCommand}" Background="Transparent" Foreground="{StaticResource SellColor}" BorderBrush="{StaticResource SellColor}" BorderThickness="1" Padding="0,10" Margin="0,0,0,8" FontSize="11" FontWeight="Black" />
                        <Button Content="RESET KILLSWITCH" Command="{Binding ResetKillSwitchCommand}" Background="Transparent" Foreground="{StaticResource BuyColor}" BorderBrush="{StaticResource BuyColor}" BorderThickness="1" Padding="0,10" FontSize="11" FontWeight="Black" />

                        <!-- WATCHLIST section -->
                        <Border Style="{StaticResource TerminalCardStyle}" Margin="0,8,0,8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="WATCHLIST" Foreground="{StaticResource TextMuted}"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding WatchlistItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelectedForBacktest}" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Symbol}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"/>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:F2}}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="8,0"/>
                                                    <TextBlock Text="{Binding ChangeText}"
                                                               Foreground="{Binding Color}" FontSize="9" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding CandidateScore, StringFormat=Score {0:F1}}"
                                                               Foreground="{StaticResource TextSoft}" FontSize="8" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="SYNC EXCHANGES"
                                        Command="{Binding SyncWatchlistCommand}"
                                        IsEnabled="{Binding IsSyncingWatchlist, Converter={StaticResource InverseBooleanConverter}}"
                                        Style="{StaticResource DeckActionButtonAccentStyle}"
                                        Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding SyncStatusMessage}"
                                           Foreground="{StaticResource TextSoft}"
                                           FontSize="9" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
