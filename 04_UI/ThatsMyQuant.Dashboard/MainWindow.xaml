                                <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="WIN RATE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding Studio.WinRate, StringFormat={}{0:F1}%}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource BuyColor}" FontSize="18" FontWeight="Black" Margin="0,4,0,0" /><TextBlock Text="{Binding Studio.ProfitFactor, StringFormat=PROFIT FACTOR {0:F2}}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,6,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="NET PERFORMANCE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding Studio.BacktestPnlLabel}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Black" Margin="0,4,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding Studio.BacktestEquityLabel}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Style="{StaticResource TerminalCardStyle}"><StackPanel><TextBlock Text="RISK QUALITY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding Studio.BacktestRiskSummary}" FontSize="13" FontWeight="Black" Foreground="{StaticResource TextSoft}" Margin="0,4,0,0" TextWrapping="Wrap" /><TextBlock Text="STRATEGY EFFICIENCY METRIC" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource TerminalCardStyle}" Margin="0,0,12,0" Background="{StaticResource AppBg}">
                                    <StackPanel>
                                        <TextBlock Text="BACKTEST REPLAY VIEW" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,10" />
