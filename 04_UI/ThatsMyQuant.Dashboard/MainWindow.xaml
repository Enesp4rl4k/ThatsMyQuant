                                                                        <TextBlock Text="{Binding StrategyTag}" FontSize="10" FontWeight="Black" Foreground="{StaticResource TextMain}" />
                                                                        <TextBlock Text="{Binding ExitReason, StringFormat=EXIT: {0}}" Foreground="{StaticResource TextSoft}" FontSize="8" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding PnL, StringFormat={}{0:N2}}" FontFamily="{StaticResource MonoFont}" Foreground="{Binding Color}" FontSize="11" FontWeight="Black" />
                                                                        <TextBlock Text="{Binding PnLPercent, StringFormat={}{0:F2}%}" FontFamily="{StaticResource MonoFont}" Foreground="{Binding Color}" FontSize="8" HorizontalAlignment="Right" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="GLOBAL MARKET ANALYSIS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,16,0,10" />
                                        <DataGrid Grid.Row="2" ItemsSource="{Binding Studio.GlobalBacktestResults}" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None" MaxHeight="250" VerticalScrollBarVisibility="Auto">
