<Window x:Class="ThatsMyQuant.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thats My Quant | Institutional Terminal"
        Height="940"
        Width="1560"
        MinHeight="820"
        MinWidth="1320"
        Background="{StaticResource AppBg}"
        Foreground="{StaticResource TextMain}"
        FontFamily="{StaticResource PrimaryFont}"
        WindowStartupLocation="CenterScreen"
        xmlns:controls="clr-namespace:ThatsMyQuant.Dashboard.Controls"
    xmlns:converters="clr-namespace:ThatsMyQuant.Dashboard.Converters">
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" Background="Transparent" IsItemsHost="True" Margin="0,0,0,10" />
                            <Border Grid.Row="1" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8">
                                <ContentPresenter x:Name="PART_SelectedContentHost" Margin="0" ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AppBg}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1,2,1,0" />
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TextSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0B1630" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="BorderBrush" Value="#173562" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DeckActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DeckActionButtonAccentStyle" TargetType="Button" BasedOn="{StaticResource DeckActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="TimeframeButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="Transparent" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#173562" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource TextSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />   <!-- Logo Section -->
                    <ColumnDefinition Width="*" />      <!-- Spacer -->
                    <ColumnDefinition Width="Auto" />   <!-- Telemetry & Health -->
                    <ColumnDefinition Width="Auto" />   <!-- Session PnL -->
                    <ColumnDefinition Width="Auto" />   <!-- Mode Indicator -->
                    <ColumnDefinition Width="Auto" />   <!-- Zen Toggle -->
                </Grid.ColumnDefinitions>
                <!-- 1. Logo Section -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource AppBg}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="Q" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="THATSMYQUANT TERMINAL" FontSize="15" FontWeight="Black" Foreground="{StaticResource TextMain}" />
                        <TextBlock Text="INSTITUTIONAL GRADE EXECUTION" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold" Margin="1,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. Connectivity & Health (Pulse) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <Ellipse Width="6" Height="6" Fill="#3FB950" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="SYS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <Ellipse Width="6" Height="6" Fill="#3FB950" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="API" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#3FB950" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="AI" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PING" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ApiPing}" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. Session PnL -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="REALIZED PnL" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding PortfolioView.RealizedPnL, StringFormat={}{0:N2}}" Foreground="{StaticResource BuyColor}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Black" HorizontalAlignment="Right" Margin="0,-2,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="UNREALIZED" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding PortfolioView.UnrealizedPnL, StringFormat={}{0:N2}}" Foreground="{StaticResource BuyColor}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Black" HorizontalAlignment="Right" Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 4. Mode Indicator -->
                <Border Grid.Column="4" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{Binding TradingModeColor}" CornerRadius="2" Padding="8,3">
                            <TextBlock Text="{Binding TradingModeLabel}" Foreground="White" FontSize="10" FontWeight="Black" />
                        </Border>
                    </StackPanel>
                </Border>
                
                <Button Grid.Column="5" Command="{Binding ToggleZenModeCommand}" Background="Transparent" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12,4" Margin="12,0,0,0">
                    <TextBlock Text="ZEN MODE" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Black" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="336">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="336" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="MainTabs" Grid.Column="0" Margin="0,0,24,0">
                <TabItem Header="Terminal">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Summary Cards -->
                            <RowDefinition Height="*" />    <!-- Main Chart -->
                            <RowDefinition Height="Auto" /> <!-- Terminal Brief -->
                            <RowDefinition Height="160" />  <!-- Active Positions -->
                        </Grid.RowDefinitions>

                        <!-- 1. Executive Summary Cards -->
                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                            <UniformGrid.Style>
                                <Style TargetType="UniformGrid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Style>
                            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL LIQUIDITY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PortfolioView.Balance, StringFormat={}${0:N0}}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="DAILY PNL (NET)" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PortfolioView.RealizedPnLPercent, StringFormat={}{0:F2}%}" FontFamily="{StaticResource MonoFont}" Foreground="{Binding PortfolioView.RealizedPnLColor}" FontSize="18" FontWeight="Black" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="OPEN POSITIONS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PortfolioView.ActivePositions.Count}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TerminalCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="RISK EXPOSURE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding RiskRewardRatio, StringFormat=R/R 1:{0:F2}}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Margin="0,0,0,10" Padding="12,10">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TerminalCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="LIVE EXECUTION BRIEF" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding BotStatusSummary}" Foreground="{StaticResource TextMain}" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="46" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="SESSION BRIEFING" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DailyMarketBriefing}" Foreground="{StaticResource TextSoft}" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="42" />
                                </StackPanel>
                                <UniformGrid Grid.Column="2" Columns="2">
                                    <Button Style="{StaticResource DeckActionButtonAccentStyle}" Command="{Binding RefreshAnalysisCommand}" Content="RUN SCAN" Margin="0,0,6,6" Padding="0,8" />
                                    <Button Style="{StaticResource DeckActionButtonStyle}" Command="{Binding StartTradingCommand}" Content="START LOOP" Margin="6,0,0,6" Padding="0,8" />
                                    <Button Style="{StaticResource DeckActionButtonStyle}" Command="{Binding RunBacktestCommand}" Content="BACKTEST" Margin="0,0,6,0" Padding="0,8" />
                                    <Button Style="{StaticResource DeckActionButtonStyle}" Command="{Binding ToggleTradingModeCommand}" Content="TOGGLE MODE" Margin="6,0,0,0" Padding="0,8" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- 2. Main Charting Area -->
                        <Border Grid.Row="1" Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,10" MinHeight="520">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MarketOverview.IsTradingViewActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <TextBlock Text="{Binding MarketOverview.ChartHeaderTitle}" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="Black" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <RadioButton Content="1m" GroupName="TF" Style="{StaticResource TimeframeButtonStyle}" IsChecked="{Binding MarketOverview.SelectedTimeframe, Converter={StaticResource StringToBoolConverter}, ConverterParameter=1m}" />
                                        <RadioButton Content="5m" GroupName="TF" Style="{StaticResource TimeframeButtonStyle}" IsChecked="{Binding MarketOverview.SelectedTimeframe, Converter={StaticResource StringToBoolConverter}, ConverterParameter=5m}" />
                                        <RadioButton Content="15m" GroupName="TF" Style="{StaticResource TimeframeButtonStyle}" IsChecked="{Binding MarketOverview.SelectedTimeframe, Converter={StaticResource StringToBoolConverter}, ConverterParameter=15m}" />
                                        <RadioButton Content="1h" GroupName="TF" Style="{StaticResource TimeframeButtonStyle}" IsChecked="{Binding MarketOverview.SelectedTimeframe, Converter={StaticResource StringToBoolConverter}, ConverterParameter=1h}" />
                                        <RadioButton Content="4h" GroupName="TF" Style="{StaticResource TimeframeButtonStyle}" IsChecked="{Binding MarketOverview.SelectedTimeframe, Converter={StaticResource StringToBoolConverter}, ConverterParameter=4h}" />
                                        <RadioButton Content="1d" GroupName="TF" Style="{StaticResource TimeframeButtonStyle}" IsChecked="{Binding MarketOverview.SelectedTimeframe, Converter={StaticResource StringToBoolConverter}, ConverterParameter=1d}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding MarketOverview.ChartHeaderOhlc}" Foreground="{Binding MarketOverview.ChartHeaderChangeColor}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <controls:ScientificChartControl x:Name="CockpitChart" Grid.Row="1" MinHeight="450" DataContext="{Binding MarketOverview}" />
                                <Border Grid.Row="2" Background="{StaticResource SurfaceBg}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="AI VISUAL REASONING" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <TextBlock Text="{Binding AiAnalystView.VisualReasoningSummary}" Foreground="{StaticResource TextMain}" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="34" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="STRATEGY CONTEXT" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <TextBlock Text="{Binding AiAnalystView.TradeReadiness}" Foreground="{Binding AiAnalystView.TradeReadinessColor}" FontSize="14" FontWeight="Black" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>

                                <!-- FLOATING ZEN MODE EXIT BUTTON (Visible only when in Zen Mode) -->
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Margin="0,4,20,0" Grid.Row="1"
                                        Command="{Binding ToggleZenModeCommand}"
                                        Width="28" Height="28"
                                        Background="#CC0B0E13"
                                        BorderBrush="{StaticResource Accent}"
                                        BorderThickness="1"
                                        ToolTip="Exit Zen Mode (Hotkey: Z)"
                                        Panel.ZIndex="1000">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="✕" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 3. Active Operations Ledger (DataGrid) -->
                        <Border Grid.Row="3" Padding="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TerminalCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock Text="LIVE COMMAND CENTER / ACTIVE POSITIONS" Foreground="{StaticResource TextMain}" FontSize="10" FontWeight="Black" VerticalAlignment="Center" />
                                        <Button Content="PANIC: CLOSE ALL POSITIONS" Command="{Binding CloseAllPositionsCommand}" Background="#7A2F45" Foreground="White" BorderThickness="0" FontSize="9" FontWeight="Black" Padding="12,4" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                    </DockPanel>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding PortfolioView.ActivePositions}" AutoGenerateColumns="False" Background="{StaticResource AppBg}" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderColor}" CanUserAddRows="False" RowBackground="{StaticResource AppBg}" AlternatingRowBackground="{StaticResource SurfaceBg}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource BorderColor}">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBg}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="FontSize" Value="9" />
                                            <Setter Property="Padding" Value="8,6" />
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="8,4" />
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="{StaticResource AppBg}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SYMBOL" Binding="{Binding Symbol}" Width="100">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Black"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="SIDE" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><Border Background="{Binding SideColor}" CornerRadius="2" Padding="6,2"><TextBlock Text="{Binding Side}" Foreground="White" FontSize="9" FontWeight="Black" /></Border></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ROE %" Binding="{Binding Roe, StringFormat={}{0:F2}%}" Width="80">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="Foreground" Value="{Binding PnLColor}"/><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="MARK" Binding="{Binding MarkPrice, StringFormat={}{0:N2}}" Width="100">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="ACTIONS" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="BE" Command="{Binding DataContext.SetBreakEvenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="{StaticResource BgCard}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" FontSize="8" FontWeight="Bold" Padding="6,2" Margin="0,0,6,0" />
                                                        <Button Content="CLOSE" Command="{Binding DataContext.ClosePositionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="{StaticResource SurfaceBg}" Foreground="{StaticResource SellColor}" BorderBrush="{StaticResource SellColor}" BorderThickness="1" FontSize="8" FontWeight="Black" Padding="8,2" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Portfolio">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="CURRENT BALANCE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PortfolioView.PortfolioGrowthHeadline}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="GROWTH" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PortfolioView.PortfolioGrowthSubtext}" Foreground="{Binding PortfolioView.PortfolioGrowthColor}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TerminalCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="OPEN POSITIONS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PortfolioView.ActivePositions.Count}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TerminalCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="RANGE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PortfolioView.SelectedPortfolioRange}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Black" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="1" Style="{StaticResource TerminalCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="PORTFOLIO GROWTH" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Black" />
                                        <TextBlock Text="{Binding PortfolioView.PortfolioRangeSummary}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="DAILY" Command="{Binding SetPortfolioRangeCommand}" CommandParameter="Daily" Style="{StaticResource PageNavButtonStyle}" Height="30" Padding="10,0" FontSize="10" FontWeight="Bold" />
                                        <Button Content="WEEKLY" Command="{Binding SetPortfolioRangeCommand}" CommandParameter="Weekly" Style="{StaticResource PageNavButtonStyle}" Height="30" Padding="10,0" FontSize="10" FontWeight="Bold" />
                                        <Button Content="MONTHLY" Command="{Binding SetPortfolioRangeCommand}" CommandParameter="Monthly" Style="{StaticResource PageNavButtonStyle}" Height="30" Padding="10,0" FontSize="10" FontWeight="Bold" />
                                        <Button Content="YEARLY" Command="{Binding SetPortfolioRangeCommand}" CommandParameter="Yearly" Style="{StaticResource PageNavButtonStyle}" Height="30" Padding="10,0" FontSize="10" FontWeight="Bold" Margin="0,0,0,8" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="16">
                                        <Grid>
                                            <ItemsControl ItemsSource="{Binding PortfolioView.PortfolioXAxisLabels}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Text="{Binding Text}" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding PortfolioView.PortfolioYAxisLabels}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Text="{Binding Text}" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Canvas Width="760" Height="220" Margin="8,8,70,34" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Line X1="0" Y1="0" X2="760" Y2="0" Stroke="#171D26" StrokeThickness="1" />
                                                <Line X1="0" Y1="55" X2="760" Y2="55" Stroke="#171D26" StrokeThickness="1" />
                                                <Line X1="0" Y1="110" X2="760" Y2="110" Stroke="#171D26" StrokeThickness="1" />
                                                <Line X1="0" Y1="165" X2="760" Y2="165" Stroke="#171D26" StrokeThickness="1" />
                                                <Line X1="0" Y1="220" X2="760" Y2="220" Stroke="#171D26" StrokeThickness="1" />
                                                <Polyline Points="{Binding PortfolioView.PortfolioGrowthPoints}" Stroke="{Binding PortfolioView.PortfolioGrowthColor}" StrokeThickness="3" />
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="12,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SUMMARY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <TextBlock Text="{Binding PortfolioView.PortfolioGrowthHeadline}" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Black" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding PortfolioView.PortfolioGrowthSubtext}" Foreground="{Binding PortfolioView.PortfolioGrowthColor}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PortfolioView.PortfolioRangeSummary}" Foreground="{StaticResource TextSoft}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Bot Launcher">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource TerminalCardStyle}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="BOT STRATEGIES" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Black" />
                                    <TextBlock Text="Choose the bot style first, then tune launch settings on the right." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Studio.BotStrategies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="Black" />
                                                        <TextBlock Text="Use this template as the primary bot behavior for signal generation and execution rhythm." Foreground="{StaticResource TextSoft}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="SELECT"
                                                            Command="{Binding DataContext.SetSelectedBotStrategyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="{StaticResource Accent}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="12,8"
                                                            FontSize="10"
                                                            FontWeight="Black"
                                                            Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource TerminalCardStyle}">
                            <StackPanel>
                                <TextBlock Text="START BOT" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Black" />
                                <TextBlock Text="{Binding Studio.BotLaunchHint}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,12" TextWrapping="Wrap" />

                                <Border Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="STRATEGY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <ComboBox ItemsSource="{Binding Studio.BotStrategies}" SelectedItem="{Binding Studio.SelectedBotStrategy}" Background="{StaticResource SurfaceBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="OBJECTIVE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <ComboBox ItemsSource="{Binding Studio.BotObjectives}" SelectedItem="{Binding Studio.SelectedBotObjective}" Background="{StaticResource SurfaceBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,6,12">
                                            <TextBlock Text="BASE ASSET" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <ComboBox ItemsSource="{Binding Studio.BotBaseAssets}" SelectedItem="{Binding Studio.SelectedBotBaseAsset}" Background="{StaticResource SurfaceBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,12">
                                            <TextBlock Text="QUOTE ASSET" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <ComboBox ItemsSource="{Binding Studio.BotQuoteAssets}" SelectedItem="{Binding Studio.SelectedBotQuoteAsset}" Background="{StaticResource SurfaceBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,6,0">
                                            <TextBlock Text="FUNDING" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <TextBox Text="{Binding Studio.BotFundingAmount}" Background="{StaticResource SurfaceBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10,8" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="GRID DENSITY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <ComboBox ItemsSource="{Binding Studio.GridDensityOptions}" SelectedItem="{Binding Studio.GridDensity}" Background="{StaticResource SurfaceBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="GRID LIMITS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="UPPER %" Foreground="{StaticResource TextSoft}" FontSize="9" />
                                                <TextBox Text="{Binding Studio.GridUpperLimit}" Background="{StaticResource SurfaceBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10,8" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="LOWER %" Foreground="{StaticResource TextSoft}" FontSize="9" />
                                                <TextBox Text="{Binding Studio.GridLowerLimit}" Background="{StaticResource SurfaceBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="10,8" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="GRID SLOPE" Foreground="{StaticResource TextSoft}" FontSize="9" Margin="0,10,0,0" />
                                        <Slider Value="{Binding Studio.GridSlopeBias}" Minimum="0" Maximum="100" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="LAUNCH SUMMARY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Studio.BotLaunchSummary}" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Button Content="START BOT"
                                        Command="{Binding StartTradingCommand}"
                                        Background="{StaticResource Accent}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="0,14"
                                        FontSize="15"
                                        FontWeight="Black" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Strategy &amp; AI Studio">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- 1. Technical & AI Calibration -->
                        <Border Grid.Column="0" Style="{StaticResource TerminalCardStyle}" Margin="0,0,16,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="INTELLIGENCE CALIBRATION" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,12" />
                                    
                                    <TextBlock Text="SMC / PRICE ACTION" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Black" Margin="0,0,0,8" />
                                    <Border Background="{StaticResource AppBg}" Padding="12" CornerRadius="4" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="ORDER BLOCK TIMEFRAME" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <ComboBox ItemsSource="{Binding Studio.TimeframeOptions}" SelectedItem="{Binding Studio.ObTimeframe}" Background="{StaticResource AppBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Margin="0,6,0,12" />
                                            
                                            <TextBlock Text="FVG SENSITIVITY" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <Slider Value="{Binding Studio.FvgSensitivity}" Minimum="0" Maximum="100" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Studio.FvgSensitivity, StringFormat={}{0:F0}%}" Foreground="{StaticResource TextSoft}" FontSize="9" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="AI DECISION MODULE" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Black" Margin="0,0,0,8" />
                                    <Border Background="{StaticResource AppBg}" Padding="12" CornerRadius="4" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="MIN CONFIDENCE THRESHOLD" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <Slider Value="{Binding Studio.AiConfidenceThreshold}" Minimum="0" Maximum="100" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Studio.AiConfidenceThreshold, StringFormat={}{0:F0}%}" Foreground="{StaticResource TextSoft}" FontSize="9" HorizontalAlignment="Right" />
                                            
                                            <CheckBox Content="AUTO-PILOT MODE (AI SIGNALS)" IsChecked="{Binding Studio.IsAiAutomationEnabled}" Foreground="White" FontSize="10" Margin="0,12,0,0" />
                                            
                                            <Button Content="CALIBRATE AI MODULE" Command="{Binding CalibrateAiCommand}" Background="{StaticResource SurfaceBg}" Foreground="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" BorderThickness="1" FontSize="9" FontWeight="Black" Padding="0,8" Margin="0,16,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="INSTITUTIONAL RISK LIMITS" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Black" Margin="0,0,0,8" />
                                    <Border Background="{StaticResource AppBg}" Padding="12" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="DAILY MAX LOSS (%)" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <TextBox Text="{Binding Studio.RiskDailyLossLimit}" FontFamily="{StaticResource MonoFont}" Background="{StaticResource AppBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="8" Margin="0,6,0,12" />
                                            
                                            <TextBlock Text="MAX POSITION SIZE (%)" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" />
                                            <TextBox Text="{Binding Studio.RiskMaxPositionSize}" FontFamily="{StaticResource MonoFont}" Background="{StaticResource AppBg}" Foreground="White" BorderBrush="{StaticResource BorderColor}" Padding="8" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- 2. Logic Confluence Tree -->
                        <Border Grid.Column="1" Style="{StaticResource TerminalCardStyle}">
                            <StackPanel>
                                <TextBlock Text="CONFLUENCE LOGIC TREE" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="The bot continuously scans these conditions based on your Studio settings. Only confluence in high-probability zones triggers execution." Foreground="{StaticResource TextSoft}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <ItemsControl ItemsSource="{Binding EntryChecklist}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Black" Foreground="{StaticResource TextMain}" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding Color}" FontSize="10" FontWeight="Black" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Trade Ledger &amp; Analytics">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- 1. Performance Heatmap (Mockup) -->
                        <Border Grid.Row="0" Style="{StaticResource TerminalCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="MONTHLY PERFORMANCE HEATMAP" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding CurrentYtdPerformance, StringFormat=CURRENT YTD: {0}}" Foreground="{StaticResource BuyColor}" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding MonthlyPerformance}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="12" Margin="0,10,0,0" Height="20" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Color}" Opacity="{Binding Opacity}" Margin="2" CornerRadius="2" ToolTip="{Binding ToolTip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 2. Historical Ledger -->
                        <Border Grid.Row="1" Style="{StaticResource TerminalCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock Text="HISTORICAL TRADE LEDGER" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Black" VerticalAlignment="Center" />
                                        <Button Content="EXPORT TO CSV" Command="{Binding ExportLedgerCommand}" Background="{StaticResource BgCard}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" FontSize="9" FontWeight="Bold" Padding="12,4" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                    </DockPanel>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding TradeJournal}" SelectedItem="{Binding SelectedTradeJournalEntry}" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None" VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TIME" Binding="{Binding Time, StringFormat={}{0:dd MMM HH:mm}}" Width="120">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="Foreground" Value="{StaticResource TextMuted}"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="SYMBOL" Binding="{Binding Symbol}" Width="100">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Black"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="SIDE" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Side}" Foreground="{Binding SideColor}" FontSize="10" FontWeight="Black" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="PNL" Binding="{Binding PnL, StringFormat={}{0:N2}}" Width="100">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="Foreground" Value="{Binding SideColor}"/><Setter Property="FontWeight" Value="Bold"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="REASONING" Binding="{Binding Reasoning}" Width="*">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSoft}"/><Setter Property="FontSize" Value="10"/><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- 3. AI Coaching Review -->
                        <Border Grid.Row="1" Margin="8,0,0,0" HorizontalAlignment="Right" Width="400" Style="{StaticResource TerminalCardStyle}" Visibility="{Binding SelectedTradeJournalEntry, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTradeReviewTitle}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Black" Margin="0,0,0,12" />
                                <Border Background="{StaticResource AppBg}" Padding="16" CornerRadius="4">
                                    <TextBlock Text="{Binding SelectedTradeReview}" Foreground="{StaticResource TextMain}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" />
