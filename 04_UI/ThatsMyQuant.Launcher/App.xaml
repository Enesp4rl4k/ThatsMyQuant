<Application x:Class="ThatsMyQuant.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F7FB" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0E7490" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#CFFAFE" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
    </Application.Resources>
</Application>
