[xUnit.net 00:00:00.40]       &#xD;
[xUnit.net 00:00:00.40]       namespace ThatsMyQuant.Application.HftInfrastructure;&#xD;
[xUnit.net 00:00:00.40]       &#xD;
[xUnit.net 00:00:00.40]       /// &lt;summary&gt;&#xD;
[xUnit.net 00:00:00.40]       /// A critical HFT safety mechanism. Binds to the Execution Engine and strictly monitors heartbeat timestamps.&#xD;
[xUnit.net 00:00:00.40]       /// If the matching engine or data feed goes silent for &gt;50ms, it triggers a catastrophic CancellationToken severing market access.&#xD;
[xUnit.net 00:00:00.40]       /// &lt;/summary&gt;&#xD;
[xUnit.net 00:00:00.40]       public class HeartbeatMonitor&#xD;
[xUnit.net 00:00:00.40]       {&#xD;
[xUnit.net 00:00:00.40]           private long _lastHeartbeatTick = Environment.TickCount64;&#xD;
[xUnit.net 00:00:00.40]           private readonly TimeSpan _maxStaleThreshold;&#xD;
[xUnit.net 00:00:00.40]           private readonly DeadMansSwitch _safetySwitch;&#xD;
[xUnit.net 00:00:00.40]       &#xD;
[xUnit.net 00:00:00.40]           public HeartbeatMonitor(DeadMansSwitch safetySwitch, int maxStaleMilliseconds = 50)&#xD;
[xUnit.net 00:00:00.40]           {&#xD;
[xUnit.net 00:00:00.40]               _safetySwitch = safetySwitch;&#xD;
[xUnit.net 00:00:00.40]               _maxStaleThreshold = TimeSpan.FromMilliseconds(maxStaleMilliseconds);&#xD;
[xUnit.net 00:00:00.41]           }&#xD;
[xUnit.net 00:00:00.41]       &#xD;
[xUnit.net 00:00:00.41]           /// &lt;summary&gt;&#xD;
[xUnit.net 00:00:00.41]           /// Called continuously by the market data socket on a dedicated network thread.&#xD;
[xUnit.net 00:00:00.41]           /// &lt;/summary&gt;&#xD;
[xUnit.net 00:00:00.41]           public void RecordHeartbeat()&#xD;
[xUnit.net 00:00:00.41]           {&#xD;
[xUnit.net 00:00:00.41]               _lastHeartbeatTick = Environment.TickCount64;&#xD;
[xUnit.net 00:00:00.41]           }&#xD;
[xUnit.net 00:00:00.41]       &#xD;
[xUnit.net 00:00:00.41]           /// &lt;summary&gt;&#xD;
[xUnit.net 00:00:00.41]           /// Audits the heartbeat recency. Executed strictly every 5ms on a high-priority timer.&#xD;
[xUnit.net 00:00:00.41]           /// &lt;/summary&gt;&#xD;
[xUnit.net 00:00:00.41]           public void AuditConnection()&#xD;
[xUnit.net 00:00:00.41]           {&#xD;
[xUnit.net 00:00:00.41]               if (Environment.TickCount64 - _lastHeartbeatTick &gt; _maxStaleThreshold.TotalMilliseconds)&#xD;
[xUnit.net 00:00:00.41]               {&#xD;
[xUnit.net 00:00:00.41]                   // Catastrophic latency spike or exchange failure.&#xD;
[xUnit.net 00:00:00.41]                   _safetySwitch.TriggerLiquidationEvacuation("Heartbeat stale threshold exceeded (&gt;50ms). Exchange presumed disconnected.");&#xD;
[xUnit.net 00:00:00.41]               }&#xD;
[xUnit.net 00:00:00.41]           }&#xD;
[xUnit.net 00:00:00.41]       }&#xD;
[xUnit.net 00:00:00.41]       &#xD;
[xUnit.net 00:00:00.41]       /// &lt;summary&gt;&#xD;
[xUnit.net 00:00:00.41]       /// A global fail-close mechanism. When triggered, immediately transitions the entire AppDomain into &#xD;
[xUnit.net 00:00:00.41]       /// a 'HALT' state, firing market-sell orders for all open inventory and locking further API transmission.&#xD;
[xUnit.net 00:00:00.41]       /// &lt;/summary&gt;&#xD;
