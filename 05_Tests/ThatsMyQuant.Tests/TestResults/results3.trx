[xUnit.net 00:00:00.98]       &#xD;
[xUnit.net 00:00:00.98]           private IReadOnlyList&lt;Trade&gt; MergeKnownTrades(IReadOnlyList&lt;Trade&gt;? recentTrades)&#xD;
[xUnit.net 00:00:00.98]           {&#xD;
[xUnit.net 00:00:00.98]               var merged = new Dictionary&lt;Guid, Trade&gt;();&#xD;
[xUnit.net 00:00:00.98]       &#xD;
[xUnit.net 00:00:00.98]               if (recentTrades != null)&#xD;
[xUnit.net 00:00:00.98]               {&#xD;
[xUnit.net 00:00:00.98]                   foreach (var trade in recentTrades)&#xD;
[xUnit.net 00:00:00.98]                   {&#xD;
[xUnit.net 00:00:00.98]                       merged[trade.Id] = trade;&#xD;
[xUnit.net 00:00:00.98]                   }&#xD;
[xUnit.net 00:00:00.98]               }&#xD;
[xUnit.net 00:00:00.98]       &#xD;
[xUnit.net 00:00:00.98]               foreach (var entry in _observedTrades)&#xD;
[xUnit.net 00:00:00.98]               {&#xD;
[xUnit.net 00:00:00.98]                   merged[entry.Key] = entry.Value;&#xD;
[xUnit.net 00:00:00.98]               }&#xD;
[xUnit.net 00:00:00.98]       &#xD;
[xUnit.net 00:00:00.98]               return merged.Values&#xD;
[xUnit.net 00:00:00.98]                   .OrderByDescending(t =&gt; t.ExitTime ?? t.EntryTime)&#xD;
[xUnit.net 00:00:00.98]                   .Take(_options.MaxTrackedTrades)&#xD;
[xUnit.net 00:00:00.98]                   .ToList();&#xD;
[xUnit.net 00:00:00.98]           }&#xD;
[xUnit.net 00:00:00.98]       &#xD;
[xUnit.net 00:00:00.98]           private decimal ResolveOpenHeat(IReadOnlyList&lt;Trade&gt; openTrades, decimal baseEquity)&#xD;
[xUnit.net 00:00:00.98]           {&#xD;
[xUnit.net 00:00:00.98]               var explicitHeat = openTrades.Sum(t =&gt; Math.Max(0m, t.PositionSizePercent));&#xD;
[xUnit.net 00:00:00.98]               if (explicitHeat &gt; 0m) return explicitHeat;&#xD;
[xUnit.net 00:00:00.98]       &#xD;
[xUnit.net 00:00:00.98]               if (baseEquity &lt;= 0m) return 0m;&#xD;
[xUnit.net 00:00:00.98]               return openTrades.Sum(t =&gt; Math.Max(0m, t.EntryPrice * t.Quantity) / baseEquity);&#xD;
[xUnit.net 00:00:00.98]           }&#xD;
[xUnit.net 00:00:00.98]       &#xD;
[xUnit.net 00:00:00.98]           private decimal ResolveDrawdownPercent(decimal baseEquity, IReadOnlyList&lt;Trade&gt; closedTrades)&#xD;
[xUnit.net 00:00:00.99]           {&#xD;
[xUnit.net 00:00:00.99]               if (_portfolioManager != null)&#xD;
[xUnit.net 00:00:00.99]               {&#xD;
[xUnit.net 00:00:01.00]                   var portfolioDrawdown = _portfolioManager.GetDrawdownPercent();&#xD;
[xUnit.net 00:00:01.00]                   if (portfolioDrawdown &gt; 0m) return portfolioDrawdown;&#xD;
[xUnit.net 00:00:01.00]               }&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               if (baseEquity &lt;= 0m || closedTrades.Count == 0) return 0m;&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               decimal runningEquity = baseEquity;&#xD;
[xUnit.net 00:00:01.00]               decimal peakEquity = baseEquity;&#xD;
[xUnit.net 00:00:01.00]               decimal maxDrawdown = 0m;&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               foreach (var trade in closedTrades.OrderBy(t =&gt; t.ExitTime ?? t.EntryTime))&#xD;
[xUnit.net 00:00:01.00]               {&#xD;
[xUnit.net 00:00:01.00]                   runningEquity += CalculateNetPnl(trade);&#xD;
[xUnit.net 00:00:01.00]                   if (runningEquity &gt; peakEquity) peakEquity = runningEquity;&#xD;
[xUnit.net 00:00:01.00]                   if (peakEquity &lt;= 0m) continue;&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]                   var drawdown = ((peakEquity - runningEquity) / peakEquity) * 100m;&#xD;
[xUnit.net 00:00:01.00]                   if (drawdown &gt; maxDrawdown) maxDrawdown = drawdown;&#xD;
[xUnit.net 00:00:01.00]               }&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               return Math.Max(0m, maxDrawdown);&#xD;
[xUnit.net 00:00:01.00]           }&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]           private static decimal ResolveDailyLossPercent(decimal baseEquity, IReadOnlyList&lt;Trade&gt; closedTrades)&#xD;
[xUnit.net 00:00:01.00]           {&#xD;
[xUnit.net 00:00:01.00]               if (baseEquity &lt;= 0m) return 0m;&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               var dailyPnl = closedTrades&#xD;
[xUnit.net 00:00:01.00]                   .Where(t =&gt; t.ExitTime.HasValue &amp;&amp; t.ExitTime.Value.Date == DateTime.UtcNow.Date)&#xD;
[xUnit.net 00:00:01.00]                   .Sum(CalculateNetPnl);&#xD;
[xUnit.net 00:00:01.00]               return Math.Abs(Math.Min(0m, dailyPnl) / baseEquity) * 100m;&#xD;
[xUnit.net 00:00:01.00]           }&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]           private decimal ResolveExecutionHealth(IReadOnlyList&lt;Trade&gt; closedTrades)&#xD;
[xUnit.net 00:00:01.00]           {&#xD;
[xUnit.net 00:00:01.00]               var liveTrades = closedTrades&#xD;
[xUnit.net 00:00:01.00]                   .Where(IsLiveTrade)&#xD;
[xUnit.net 00:00:01.00]                   .Take(_options.AdaptiveLookbackTrades)&#xD;
[xUnit.net 00:00:01.00]                   .ToList();&#xD;
[xUnit.net 00:00:01.00]               if (liveTrades.Count &lt; _options.MinimumClosedTradesForAdaptiveSizing)&#xD;
[xUnit.net 00:00:01.00]                   return 1m;&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               var avgSlippage = liveTrades.Average(t =&gt; Math.Abs(t.EntrySlippagePercent));&#xD;
[xUnit.net 00:00:01.00]               var avgLatency = liveTrades.Average(t =&gt; (decimal)Math.Max(0L, t.ExecutionLatencyMs));&#xD;
[xUnit.net 00:00:01.00]               var venueBiasValues = liveTrades&#xD;
[xUnit.net 00:00:01.00]                   .Select(t =&gt; t.VenueExecutionBias &gt; 0m ? t.VenueExecutionBias : 1m)&#xD;
[xUnit.net 00:00:01.00]                   .ToList();&#xD;
[xUnit.net 00:00:01.00]               var avgVenueBias = venueBiasValues.Count &gt; 0 ? venueBiasValues.Average() : 1m;&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               var slippageScore = ScoreInverse(avgSlippage, _options.PreferredEntrySlippagePercent, _options.HardEntrySlippagePercent);&#xD;
[xUnit.net 00:00:01.00]               var latencyScore = ScoreInverse(avgLatency, _options.PreferredExecutionLatencyMs, _options.HardExecutionLatencyMs);&#xD;
[xUnit.net 00:00:01.00]               var venueScore = Clamp(avgVenueBias, 0.50m, 1.05m);&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               return Clamp((slippageScore * 0.45m) + (latencyScore * 0.35m) + (venueScore * 0.20m), 0m, 1.05m);&#xD;
[xUnit.net 00:00:01.00]           }&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]           private decimal ResolveExecutionMultiplier(decimal executionHealth)&#xD;
[xUnit.net 00:00:01.00]               =&gt; Clamp(&#xD;
[xUnit.net 00:00:01.00]                   _options.MinimumExecutionMultiplier +&#xD;
[xUnit.net 00:00:01.00]                   ((_options.MaximumExecutionMultiplier - _options.MinimumExecutionMultiplier) * executionHealth),&#xD;
[xUnit.net 00:00:01.00]                   _options.MinimumExecutionMultiplier,&#xD;
[xUnit.net 00:00:01.00]                   _options.MaximumExecutionMultiplier);&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]           private decimal ResolvePerformanceMultiplier(IReadOnlyList&lt;Trade&gt; closedTrades, Signal? signal)&#xD;
[xUnit.net 00:00:01.00]           {&#xD;
[xUnit.net 00:00:01.00]               var sample = closedTrades&#xD;
[xUnit.net 00:00:01.00]                   .Where(t =&gt; signal == null || string.Equals(t.Symbol, signal.Symbol, StringComparison.OrdinalIgnoreCase))&#xD;
[xUnit.net 00:00:01.00]                   .Take(_options.AdaptiveLookbackTrades)&#xD;
[xUnit.net 00:00:01.00]                   .ToList();&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               if (sample.Count &lt; _options.MinimumClosedTradesForAdaptiveSizing)&#xD;
[xUnit.net 00:00:01.00]               {&#xD;
[xUnit.net 00:00:01.00]                   sample = closedTrades&#xD;
[xUnit.net 00:00:01.00]                       .Take(_options.AdaptiveLookbackTrades)&#xD;
[xUnit.net 00:00:01.00]                       .ToList();&#xD;
[xUnit.net 00:00:01.00]               }&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               if (sample.Count &lt; _options.MinimumClosedTradesForAdaptiveSizing)&#xD;
[xUnit.net 00:00:01.00]                   return 1m;&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               var wins = sample.Where(t =&gt; CalculateNetPnl(t) &gt; 0m).ToList();&#xD;
[xUnit.net 00:00:01.00]               var losses = sample.Where(t =&gt; CalculateNetPnl(t) &lt; 0m).ToList();&#xD;
[xUnit.net 00:00:01.00]               var grossProfit = wins.Sum(CalculateNetPnl);&#xD;
[xUnit.net 00:00:01.00]               var grossLoss = Math.Abs(losses.Sum(CalculateNetPnl));&#xD;
[xUnit.net 00:00:01.00]               var winRate = sample.Count == 0 ? 0m : wins.Count / (decimal)sample.Count;&#xD;
[xUnit.net 00:00:01.00]               var profitFactor = grossLoss &lt;= 0m&#xD;
[xUnit.net 00:00:01.00]                   ? (grossProfit &gt; 0m ? 3m : 1m)&#xD;
[xUnit.net 00:00:01.00]                   : grossProfit / grossLoss;&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               var adaptiveKelly = KellyCriterionCalculator.CalculateFractionalKelly(&#xD;
[xUnit.net 00:00:01.00]                   winRate,&#xD;
[xUnit.net 00:00:01.00]                   Math.Max(1m, profitFactor),&#xD;
[xUnit.net 00:00:01.00]                   _options.FractionalKelly);&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]               return Clamp(&#xD;
[xUnit.net 00:00:01.00]                   _options.MinimumPerformanceMultiplier + (adaptiveKelly * (_options.MaximumPerformanceMultiplier - _options.MinimumPerformanceMultiplier) * 2m),&#xD;
[xUnit.net 00:00:01.00]                   _options.MinimumPerformanceMultiplier,&#xD;
[xUnit.net 00:00:01.00]                   _options.MaximumPerformanceMultiplier);&#xD;
[xUnit.net 00:00:01.00]           }&#xD;
[xUnit.net 00:00:01.00]       &#xD;
[xUnit.net 00:00:01.00]           private decimal ResolveDrawdownMultiplier(decimal drawdownPercent)&#xD;
[xUnit.net 00:00:01.00]           {&#xD;
[xUnit.net 00:00:01.01]               if (drawdownPercent &lt;= _options.SoftDrawdownPercent) return 1m;&#xD;
[xUnit.net 00:00:01.01]               if (drawdownPercent &gt;= _options.HardDrawdownPercent) return _options.MinimumDrawdownMultiplier;&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]               var span = _options.HardDrawdownPercent - _options.SoftDrawdownPercent;&#xD;
[xUnit.net 00:00:01.01]               if (span &lt;= 0m) return _options.MinimumDrawdownMultiplier;&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]               var progress = (drawdownPercent - _options.SoftDrawdownPercent) / span;&#xD;
[xUnit.net 00:00:01.01]               return Clamp(1m - ((1m - _options.MinimumDrawdownMultiplier) * progress), _options.MinimumDrawdownMultiplier, 1m);&#xD;
[xUnit.net 00:00:01.01]           }&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]           private decimal ResolveHeatCompressionMultiplier(decimal openHeat)&#xD;
[xUnit.net 00:00:01.01]           {&#xD;
[xUnit.net 00:00:01.01]               var softHeat = _options.MaxPortfolioHeat * 0.70m;&#xD;
[xUnit.net 00:00:01.01]               if (openHeat &lt;= softHeat) return 1m;&#xD;
[xUnit.net 00:00:01.01]               if (openHeat &gt;= _options.MaxPortfolioHeat) return 0.35m;&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]               var progress = (openHeat - softHeat) / Math.Max(0.0001m, _options.MaxPortfolioHeat - softHeat);&#xD;
[xUnit.net 00:00:01.01]               return Clamp(1m - (0.65m * progress), 0.35m, 1m);&#xD;
[xUnit.net 00:00:01.01]           }&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]           private decimal ResolveCorrelationCompressionMultiplier(decimal correlatedHeat)&#xD;
[xUnit.net 00:00:01.01]           {&#xD;
[xUnit.net 00:00:01.01]               var softCorrelation = _options.MaxCorrelatedExposure * 0.75m;&#xD;
[xUnit.net 00:00:01.01]               if (correlatedHeat &lt;= softCorrelation) return 1m;&#xD;
[xUnit.net 00:00:01.01]               if (correlatedHeat &gt;= _options.MaxCorrelatedExposure) return 0.25m;&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]               var progress = (correlatedHeat - softCorrelation) / Math.Max(0.0001m, _options.MaxCorrelatedExposure - softCorrelation);&#xD;
[xUnit.net 00:00:01.01]               return Clamp(1m - (0.75m * progress), 0.25m, 1m);&#xD;
[xUnit.net 00:00:01.01]           }&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]           private decimal ResolveLiquidityMultiplier(decimal symbol24hVolume)&#xD;
[xUnit.net 00:00:01.01]           {&#xD;
[xUnit.net 00:00:01.01]               if (symbol24hVolume &lt;= 0m) return 1m;&#xD;
[xUnit.net 00:00:01.01]               if (symbol24hVolume &lt;= _options.HardLiquidity24hVolume) return 0.25m;&#xD;
[xUnit.net 00:00:01.01]               if (symbol24hVolume &gt;= _options.SoftLiquidity24hVolume) return 1m;&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]               var progress = (symbol24hVolume - _options.HardLiquidity24hVolume) /&#xD;
[xUnit.net 00:00:01.01]                              Math.Max(1m, _options.SoftLiquidity24hVolume - _options.HardLiquidity24hVolume);&#xD;
[xUnit.net 00:00:01.01]               return Clamp(0.25m + (0.75m * progress), 0.25m, 1m);&#xD;
[xUnit.net 00:00:01.01]           }&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]           private decimal ResolveHeadroomCap(Signal? signal, PortfolioRiskState state, RiskParameters riskProfile)&#xD;
[xUnit.net 00:00:01.01]           {&#xD;
[xUnit.net 00:00:01.01]               var caps = new List&lt;decimal&gt;&#xD;
[xUnit.net 00:00:01.01]               {&#xD;
[xUnit.net 00:00:01.01]                   riskProfile.MaxPositionSizePercent / 100m,&#xD;
[xUnit.net 00:00:01.01]                   Math.Max(0m, _options.MaxPortfolioHeat - state.OpenHeat)&#xD;
[xUnit.net 00:00:01.01]               };&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]               if (signal != null)&#xD;
[xUnit.net 00:00:01.01]               {&#xD;
[xUnit.net 00:00:01.01]                   caps.Add(Math.Max(0m, _options.MaxSymbolExposure - state.SymbolHeat));&#xD;
[xUnit.net 00:00:01.01]                   caps.Add(Math.Max(0m, _options.MaxCorrelatedExposure - state.CorrelatedHeat));&#xD;
[xUnit.net 00:00:01.01]               }&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]               return caps.Min();&#xD;
[xUnit.net 00:00:01.01]           }&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]           private decimal CalculateConfidenceKelly(TradeDecision candidate, RiskParameters riskProfile)&#xD;
[xUnit.net 00:00:01.01]           {&#xD;
[xUnit.net 00:00:01.01]               var p = Clamp(candidate.Confidence / 100m, 0m, 0.99m);&#xD;
[xUnit.net 00:00:01.01]               var q = 1m - p;&#xD;
[xUnit.net 00:00:01.01]               const decimal b = 1.5m;&#xD;
[xUnit.net 00:00:01.01]               var rawKelly = Math.Max(0m, (b * p - q) / b);&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]               return Math.Min(rawKelly * _options.FractionalKelly, riskProfile.MaxPositionSizePercent / 100m);&#xD;
[xUnit.net 00:00:01.01]           }&#xD;
[xUnit.net 00:00:01.01]       &#xD;
[xUnit.net 00:00:01.01]           private static decimal ScoreInverse(decimal actual, decimal preferred, decimal hard)&#xD;
