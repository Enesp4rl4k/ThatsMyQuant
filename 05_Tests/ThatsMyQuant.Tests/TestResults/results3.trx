[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]           private void SyncPortfolioSnapshot(Trade? previous, Trade trade)&#xD;
[xUnit.net 00:00:00.94]           {&#xD;
[xUnit.net 00:00:00.94]               if (_portfolioManager == null) return;&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               if (previous is { Status: TradeStatus.Executed } &amp;&amp; !previous.IsClosed &amp;&amp;&#xD;
[xUnit.net 00:00:00.94]                   (trade.IsClosed || trade.Status != TradeStatus.Executed))&#xD;
[xUnit.net 00:00:00.94]               {&#xD;
[xUnit.net 00:00:00.95]                   _portfolioManager.ClosePosition(previous.Symbol, trade.ExitPrice &gt; 0m ? trade.ExitPrice : previous.EntryPrice);&#xD;
[xUnit.net 00:00:00.95]               }&#xD;
[xUnit.net 00:00:00.95]       &#xD;
[xUnit.net 00:00:00.95]               if (trade.Status == TradeStatus.Executed &amp;&amp; !trade.IsClosed)&#xD;
[xUnit.net 00:00:00.95]               {&#xD;
[xUnit.net 00:00:00.95]                   _portfolioManager.OpenPosition(&#xD;
[xUnit.net 00:00:00.95]                       trade.Symbol,&#xD;
[xUnit.net 00:00:00.95]                       trade.EntryPrice,&#xD;
[xUnit.net 00:00:00.95]                       trade.Quantity,&#xD;
[xUnit.net 00:00:00.95]                       trade.Side == TradeSide.Buy);&#xD;
[xUnit.net 00:00:00.95]               }&#xD;
[xUnit.net 00:00:00.95]               else if (trade.Status == TradeStatus.Executed &amp;&amp; trade.IsClosed)&#xD;
[xUnit.net 00:00:00.95]               {&#xD;
[xUnit.net 00:00:00.95]                   _portfolioManager.ClosePosition(trade.Symbol, trade.ExitPrice &gt; 0m ? trade.ExitPrice : trade.EntryPrice);&#xD;
[xUnit.net 00:00:00.95]               }&#xD;
[xUnit.net 00:00:00.95]           }&#xD;
[xUnit.net 00:00:00.95]       &#xD;
[xUnit.net 00:00:00.95]           private void TrimObservedTradesIfNeeded()&#xD;
[xUnit.net 00:00:00.95]           {&#xD;
[xUnit.net 00:00:00.95]               if (_observedTrades.Count &lt;= _options.MaxTrackedTrades) return;&#xD;
[xUnit.net 00:00:00.95]       &#xD;
[xUnit.net 00:00:00.95]               var staleTradeIds = _observedTrades.Values&#xD;
[xUnit.net 00:00:00.95]                   .Where(t =&gt; t.IsClosed)&#xD;
[xUnit.net 00:00:00.95]                   .OrderBy(t =&gt; t.ExitTime ?? t.EntryTime)&#xD;
[xUnit.net 00:00:00.95]                   .Take(Math.Max(1, _observedTrades.Count - _options.MaxTrackedTrades))&#xD;
[xUnit.net 00:00:00.95]                   .Select(t =&gt; t.Id)&#xD;
[xUnit.net 00:00:00.95]                   .ToList();&#xD;
[xUnit.net 00:00:00.95]       &#xD;
[xUnit.net 00:00:00.95]               foreach (var tradeId in staleTradeIds)&#xD;
[xUnit.net 00:00:00.95]               {&#xD;
[xUnit.net 00:00:00.95]                   _observedTrades.TryRemove(tradeId, out _);&#xD;
[xUnit.net 00:00:00.95]               }&#xD;
[xUnit.net 00:00:00.95]           }&#xD;
