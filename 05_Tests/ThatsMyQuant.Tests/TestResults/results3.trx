[xUnit.net 00:00:00.92]           public Task&lt;(bool Approved, string Reason, decimal SafePositionSizePercent)&gt; EvaluateAsync(&#xD;
[xUnit.net 00:00:00.92]               TradeDecision candidate,&#xD;
[xUnit.net 00:00:00.92]               RiskParameters riskProfile,&#xD;
[xUnit.net 00:00:00.92]               decimal symbol24hVolume,&#xD;
[xUnit.net 00:00:00.92]               IReadOnlyList&lt;Trade&gt;? recentTrades = null,&#xD;
[xUnit.net 00:00:00.92]               Signal? signal = null)&#xD;
[xUnit.net 00:00:00.92]           {&#xD;
[xUnit.net 00:00:00.92]               if (_softPauseArmed) return Task.FromResult((false, $"Soft pause is armed: {_softPauseReason}", 0m));&#xD;
[xUnit.net 00:00:00.92]               if (!_rateLimiter.TryConsume()) return Task.FromResult((false, "HFT Rate limit exceeded.", 0m));&#xD;
[xUnit.net 00:00:00.92]       &#xD;
[xUnit.net 00:00:00.92]               var state = BuildPortfolioState(&#xD;
[xUnit.net 00:00:00.92]                   recentTrades,&#xD;
[xUnit.net 00:00:00.92]                   signal,&#xD;
[xUnit.net 00:00:00.92]                   candidate.PositionSizePercent,&#xD;
[xUnit.net 00:00:00.92]                   riskProfile,&#xD;
[xUnit.net 00:00:00.92]                   riskProfile.StartingEquity);&#xD;
[xUnit.net 00:00:00.92]       &#xD;
[xUnit.net 00:00:00.92]               if (state.DrawdownPercent &gt;= _options.HardDrawdownPercent)&#xD;
[xUnit.net 00:00:00.92]                   return Task.FromResult((false, "Hard drawdown guard is active.", 0m));&#xD;
[xUnit.net 00:00:00.92]       &#xD;
[xUnit.net 00:00:00.92]               if (state.ExecutionHealth &lt; _options.MinimumExecutionHealthToTrade)&#xD;
[xUnit.net 00:00:00.92]                   return Task.FromResult((false, "Execution quality is too weak for new risk.", 0m));&#xD;
[xUnit.net 00:00:00.92]       &#xD;
[xUnit.net 00:00:00.92]               decimal confidenceKelly = CalculateConfidenceKelly(candidate, riskProfile);&#xD;
[xUnit.net 00:00:00.92]               decimal requestedFraction = candidate.PositionSizePercent &gt; 0m&#xD;
[xUnit.net 00:00:00.92]                   ? candidate.PositionSizePercent&#xD;
[xUnit.net 00:00:00.92]                   : riskProfile.MaxPositionSizePercent / 100m;&#xD;
[xUnit.net 00:00:00.93]       &#xD;
[xUnit.net 00:00:00.93]               decimal safeAllocation = Math.Min(requestedFraction, confidenceKelly);&#xD;
[xUnit.net 00:00:00.93]               safeAllocation *= state.DrawdownMultiplier;&#xD;
[xUnit.net 00:00:00.93]               safeAllocation *= state.ExecutionMultiplier;&#xD;
[xUnit.net 00:00:00.93]               safeAllocation *= state.PerformanceMultiplier;&#xD;
[xUnit.net 00:00:00.93]               safeAllocation *= ResolveHeatCompressionMultiplier(state.OpenHeat);&#xD;
[xUnit.net 00:00:00.93]               safeAllocation *= ResolveCorrelationCompressionMultiplier(state.CorrelatedHeat);&#xD;
[xUnit.net 00:00:00.93]               safeAllocation *= ResolveLiquidityMultiplier(symbol24hVolume);&#xD;
[xUnit.net 00:00:00.93]               safeAllocation = Math.Min(safeAllocation, ResolveHeadroomCap(signal, state, riskProfile));&#xD;
[xUnit.net 00:00:00.93]       &#xD;
[xUnit.net 00:00:00.93]               if (safeAllocation &lt;= _options.MinimumTradableFraction)&#xD;
[xUnit.net 00:00:00.93]               {&#xD;
[xUnit.net 00:00:00.93]                   return Task.FromResult((false, "Risk governor compressed size below minimum tradable threshold.", 0m));&#xD;
[xUnit.net 00:00:00.93]               }&#xD;
[xUnit.net 00:00:00.93]       &#xD;
[xUnit.net 00:00:00.93]               var reasons = new List&lt;string&gt;&#xD;
[xUnit.net 00:00:00.93]               {&#xD;
[xUnit.net 00:00:00.93]                   $"size={safeAllocation:P2}",&#xD;
[xUnit.net 00:00:00.93]                   $"drawdown={state.DrawdownPercent:F2}%",&#xD;
[xUnit.net 00:00:00.93]                   $"executionHealth={state.ExecutionHealth:F2}",&#xD;
[xUnit.net 00:00:00.93]                   $"heat={state.OpenHeat:P1}"&#xD;
[xUnit.net 00:00:00.93]               };&#xD;
[xUnit.net 00:00:00.93]       &#xD;
[xUnit.net 00:00:00.93]               if (signal != null &amp;&amp; state.SymbolHeat &gt; 0m)&#xD;
[xUnit.net 00:00:00.93]                   reasons.Add($"{signal.Symbol} heat={state.SymbolHeat:P1}");&#xD;
[xUnit.net 00:00:00.93]       &#xD;
[xUnit.net 00:00:00.93]               return Task.FromResult((true, string.Join(", ", reasons), safeAllocation));&#xD;
[xUnit.net 00:00:00.93]           }&#xD;
[xUnit.net 00:00:00.93]       &#xD;
[xUnit.net 00:00:00.93]           public Task&lt;(bool Approved, string Reason)&gt; EvaluatePortfolioGuardrailsAsync(&#xD;
[xUnit.net 00:00:00.93]               IReadOnlyList&lt;Trade&gt; recentTrades,&#xD;
[xUnit.net 00:00:00.93]               Signal signal,&#xD;
[xUnit.net 00:00:00.93]               decimal requestedPositionFraction,&#xD;
[xUnit.net 00:00:00.93]               RiskParameters riskProfile,&#xD;
[xUnit.net 00:00:00.93]               decimal assumedStartingEquity = 0m)&#xD;
[xUnit.net 00:00:00.93]           {&#xD;
[xUnit.net 00:00:00.93]               if (_softPauseArmed) return Task.FromResult((false, $"Soft pause is armed: {_softPauseReason}"));&#xD;
[xUnit.net 00:00:00.93]       &#xD;
[xUnit.net 00:00:00.93]               var state = BuildPortfolioState(&#xD;
[xUnit.net 00:00:00.93]                   recentTrades,&#xD;
[xUnit.net 00:00:00.93]                   signal,&#xD;
[xUnit.net 00:00:00.93]                   requestedPositionFraction,&#xD;
[xUnit.net 00:00:00.93]                   riskProfile,&#xD;
[xUnit.net 00:00:00.93]                   assumedStartingEquity);&#xD;
[xUnit.net 00:00:00.93]       &#xD;
[xUnit.net 00:00:00.93]               var balanceCheck = CheckAvailableBalance(signal);&#xD;
[xUnit.net 00:00:00.93]               if (!balanceCheck.Approved) return Task.FromResult(balanceCheck);&#xD;
[xUnit.net 00:00:00.93]       &#xD;
[xUnit.net 00:00:00.94]               var lossCheck = CheckDailyLossLimit(state, riskProfile);&#xD;
[xUnit.net 00:00:00.94]               if (!lossCheck.Approved) return Task.FromResult(lossCheck);&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               var drawdownCheck = CheckDrawdownLimit(state);&#xD;
[xUnit.net 00:00:00.94]               if (!drawdownCheck.Approved) return Task.FromResult(drawdownCheck);&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               var countCheck = CheckConcurrentTradeLimits(state.OpenTrades, signal);&#xD;
[xUnit.net 00:00:00.94]               if (!countCheck.Approved) return Task.FromResult(countCheck);&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               var heatCheck = CheckPortfolioHeat(state);&#xD;
[xUnit.net 00:00:00.94]               if (!heatCheck.Approved) return Task.FromResult(heatCheck);&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               var symbolCheck = CheckSymbolExposure(state, signal);&#xD;
[xUnit.net 00:00:00.94]               if (!symbolCheck.Approved) return Task.FromResult(symbolCheck);&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               var correlationCheck = CheckCorrelationExposure(state, signal);&#xD;
[xUnit.net 00:00:00.94]               if (!correlationCheck.Approved) return Task.FromResult(correlationCheck);&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               var executionCheck = CheckExecutionHealth(state);&#xD;
[xUnit.net 00:00:00.94]               if (!executionCheck.Approved) return Task.FromResult(executionCheck);&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               var streakCheck = CheckLossStreak(state.ClosedTrades, signal);&#xD;
[xUnit.net 00:00:00.94]               if (!streakCheck.Approved) return Task.FromResult(streakCheck);&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               return Task.FromResult((true, "Portfolio risk checks passed."));&#xD;
[xUnit.net 00:00:00.94]           }&#xD;
