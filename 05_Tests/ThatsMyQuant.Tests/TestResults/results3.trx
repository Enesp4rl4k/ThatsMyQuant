[xUnit.net 00:00:00.94]           private (bool Approved, string Reason) CheckAvailableBalance(Signal signal)&#xD;
[xUnit.net 00:00:00.94]           {&#xD;
[xUnit.net 00:00:00.94]               if (_portfolioManager == null || string.IsNullOrWhiteSpace(signal.Symbol)) return (true, "");&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               var quoteAsset = signal.Symbol.EndsWith("USDT", StringComparison.OrdinalIgnoreCase) ? "USDT" : "TRY";&#xD;
[xUnit.net 00:00:00.94]               var available = _portfolioManager.GetAvailableBalance(quoteAsset);&#xD;
[xUnit.net 00:00:00.94]               return available &lt;= 0m ? (false, "Insufficient available balance.") : (true, "");&#xD;
[xUnit.net 00:00:00.94]           }&#xD;
