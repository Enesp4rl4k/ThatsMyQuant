[xUnit.net 00:00:00.96]           private (bool Approved, string Reason) CheckLossStreak(IReadOnlyList&lt;Trade&gt; closedTrades, Signal signal)&#xD;
[xUnit.net 00:00:00.96]           {&#xD;
[xUnit.net 00:00:00.96]               var symbolRecentTrades = closedTrades&#xD;
[xUnit.net 00:00:00.96]                   .Where(t =&gt; string.Equals(t.Symbol, signal.Symbol, StringComparison.OrdinalIgnoreCase))&#xD;
[xUnit.net 00:00:00.96]                   .OrderByDescending(t =&gt; t.ExitTime)&#xD;
[xUnit.net 00:00:00.96]                   .Take(3)&#xD;
[xUnit.net 00:00:00.96]                   .ToList();&#xD;
[xUnit.net 00:00:00.96]       &#xD;
[xUnit.net 00:00:00.96]               if (symbolRecentTrades.Count &gt;= 3 &amp;&amp; symbolRecentTrades.All(t =&gt; CalculateNetPnl(t) &lt; 0m))&#xD;
[xUnit.net 00:00:00.96]               {&#xD;
[xUnit.net 00:00:00.96]                   return (false, $"Loss-streak guard: 3 consecutive losses on {signal.Symbol}.");&#xD;
[xUnit.net 00:00:00.96]               }&#xD;
[xUnit.net 00:00:00.96]       &#xD;
[xUnit.net 00:00:00.96]               return (true, "");&#xD;
[xUnit.net 00:00:00.96]           }&#xD;
[xUnit.net 00:00:00.96]       &#xD;
[xUnit.net 00:00:00.96]           private PortfolioRiskState BuildPortfolioState(&#xD;
[xUnit.net 00:00:00.96]               IReadOnlyList&lt;Trade&gt;? recentTrades,&#xD;
