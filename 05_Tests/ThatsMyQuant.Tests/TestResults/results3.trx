[xUnit.net 00:00:00.94]           public void NotifyTradeUpdate(Trade trade)&#xD;
[xUnit.net 00:00:00.94]           {&#xD;
[xUnit.net 00:00:00.94]               if (trade == null) return;&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               _observedTrades.TryGetValue(trade.Id, out var previous);&#xD;
[xUnit.net 00:00:00.94]               _observedTrades[trade.Id] = trade;&#xD;
[xUnit.net 00:00:00.94]       &#xD;
[xUnit.net 00:00:00.94]               TrimObservedTradesIfNeeded();&#xD;
[xUnit.net 00:00:00.94]               SyncPortfolioSnapshot(previous, trade);&#xD;
