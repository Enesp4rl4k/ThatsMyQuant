[xUnit.net 00:00:00.96]               RiskParameters riskProfile,&#xD;
[xUnit.net 00:00:00.96]               decimal assumedStartingEquity)&#xD;
[xUnit.net 00:00:00.96]           {&#xD;
[xUnit.net 00:00:00.96]               var mergedTrades = MergeKnownTrades(recentTrades);&#xD;
[xUnit.net 00:00:00.96]               var executedTrades = mergedTrades&#xD;
[xUnit.net 00:00:00.96]                   .Where(t =&gt; t.Status == TradeStatus.Executed)&#xD;
[xUnit.net 00:00:00.96]                   .ToList();&#xD;
[xUnit.net 00:00:00.96]               var openTrades = executedTrades&#xD;
[xUnit.net 00:00:00.98]                   .Where(t =&gt; !t.IsClosed)&#xD;
[xUnit.net 00:00:00.98]                   .OrderByDescending(t =&gt; t.EntryTime)&#xD;
[xUnit.net 00:00:00.98]                   .ToList();&#xD;
[xUnit.net 00:00:00.98]               var closedTrades = executedTrades&#xD;
[xUnit.net 00:00:00.98]                   .Where(t =&gt; t.IsClosed)&#xD;
[xUnit.net 00:00:00.98]                   .OrderByDescending(t =&gt; t.ExitTime ?? t.EntryTime)&#xD;
[xUnit.net 00:00:00.98]                   .ToList();&#xD;
[xUnit.net 00:00:00.98]       &#xD;
[xUnit.net 00:00:00.98]               var baseEquity = GetBaseEquityForRiskCheck(assumedStartingEquity, riskProfile);&#xD;
[xUnit.net 00:00:00.98]               var openHeat = ResolveOpenHeat(openTrades, baseEquity);&#xD;
[xUnit.net 00:00:00.98]               var symbolHeat = signal == null&#xD;
[xUnit.net 00:00:00.98]                   ? 0m&#xD;
[xUnit.net 00:00:00.98]                   : ResolveOpenHeat(openTrades.Where(t =&gt; string.Equals(t.Symbol, signal.Symbol, StringComparison.OrdinalIgnoreCase)).ToList(), baseEquity);&#xD;
[xUnit.net 00:00:00.98]               var correlatedHeat = signal == null&#xD;
[xUnit.net 00:00:00.98]                   ? 0m&#xD;
[xUnit.net 00:00:00.98]                   : ResolveOpenHeat(openTrades.Where(t =&gt; IsCorrelated(t.Symbol, signal.Symbol)).ToList(), baseEquity);&#xD;
[xUnit.net 00:00:00.98]               var drawdownPercent = ResolveDrawdownPercent(baseEquity, closedTrades);&#xD;
[xUnit.net 00:00:00.98]               var dailyLossPercent = ResolveDailyLossPercent(baseEquity, closedTrades);&#xD;
[xUnit.net 00:00:00.98]               var executionHealth = ResolveExecutionHealth(closedTrades);&#xD;
[xUnit.net 00:00:00.98]       &#xD;
[xUnit.net 00:00:00.98]               return new PortfolioRiskState(&#xD;
[xUnit.net 00:00:00.98]                   OpenTrades: openTrades,&#xD;
[xUnit.net 00:00:00.98]                   ClosedTrades: closedTrades,&#xD;
[xUnit.net 00:00:00.98]                   OpenHeat: openHeat,&#xD;
[xUnit.net 00:00:00.98]                   SymbolHeat: symbolHeat,&#xD;
[xUnit.net 00:00:00.98]                   CorrelatedHeat: correlatedHeat,&#xD;
[xUnit.net 00:00:00.98]                   DrawdownPercent: drawdownPercent,&#xD;
[xUnit.net 00:00:00.98]                   DailyLossPercent: dailyLossPercent,&#xD;
[xUnit.net 00:00:00.98]                   ExecutionHealth: executionHealth,&#xD;
[xUnit.net 00:00:00.98]                   ExecutionMultiplier: ResolveExecutionMultiplier(executionHealth),&#xD;
[xUnit.net 00:00:00.98]                   PerformanceMultiplier: ResolvePerformanceMultiplier(closedTrades, signal),&#xD;
[xUnit.net 00:00:00.98]                   DrawdownMultiplier: ResolveDrawdownMultiplier(drawdownPercent),&#xD;
[xUnit.net 00:00:00.98]                   RequestedPositionFraction: requestedPositionFraction);&#xD;
