## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This .gitignore is a combination of the GitHub VisualStudio.gitignore and common .NET Core patterns.

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]inaries/
*.sublime-project
*.sublime-workspace
_Chutzpah*
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache/options
.vs/

# Visual Studio Code / JetBrains / OmniSharp
.vscode/
.omnisharp/
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Mono
mono_crash.*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Databases (local runtime state)
*.db
*.db-shm
*.db-wal
*.db.backup-*

# Logs and build diagnostics
*.log
*.log.err
*.binlog
worker_log.txt
worker_*.log*
tmq-tests.log
*_build*.log
*-build.log
*-diag.txt
build_output*.txt
app-build-diag.txt
msbuild.log
errors.log
phase*-errors.log
phase*-tests.binlog
phase8a*

# Test output
**/TestResults/
*.trx

# Environment overlays — contain OKX / Telegram / broker credentials.
# NEVER commit these. Use the committed template as a reference only.
**/appsettings.Paper.json
**/appsettings.Live.json
**/appsettings.Production.json
**/appsettings.*.local.json
**/secrets.json

# Local paper portfolio snapshot (user-specific runtime state)
paper_portfolio.json

# Dashboard-written credential stores at repo root
telegram_settings.json
exchange_credentials.dpapi
exchange_settings.json
*.dpapi

# Runtime secrets — NEVER commit
**/appsettings.runtime.json
appsettings.runtime.json
**/.env
**/.env.local
**/.env.*.local
.last_worker_log.txt
.tmp_*.ps1

# Runtime / local-only directories
logs/
_runtime_logs/
scratch/
dist/

# WPF temp build artifacts
**/*_wpftmp.csproj

# AI / agent tooling (local only — not part of the product)
.agent/
.claude/
.gemini/
.kiro/
.cursor/
.codex/
CLAUDE.md
AGENTS.md
.github/prompts/
**/__pycache__/
*.pyc

# Unrelated / personal artifacts
*.xlsx
premortem-*.html
premortem-*.md
mermaid-*.png
tmp_*.txt
Etsy_*

# Orphaned legacy sources (not in solution)
/src/
