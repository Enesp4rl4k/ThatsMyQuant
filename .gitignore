## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This .gitignore is a combination of the GitHub VisualStudio.gitignore and common .NET Core patterns.

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]inaries/
*.sublime-project
*.sublime-workspace
_Chutzpah*
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you want to ignore settings per machine
# [Ss]ettings.zip

# Visual Studio Code
.vscode/

# OmniSharp
.omnisharp/

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet Focus mode
# **/packages/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Windows image-cache files
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on separate drives
$RECYCLE.BIN/

# VS Studio folders
.vs/

# Databases
*.db

# Logs
*.log
worker_log.txt
tmq-tests.log

# Test output (local / CI artifacts)
**/TestResults/
*.trx

# Environment overlays — contain OKX / Telegram / broker credentials.
# NEVER commit these. Use the committed template as a reference only.
**/appsettings.Paper.json
**/appsettings.Live.json
**/appsettings.Production.json
**/appsettings.*.local.json
**/secrets.json

# Local paper portfolio snapshot (user-specific runtime state)
paper_portfolio.json

# Dashboard-written credential stores at repo root
telegram_settings.json
exchange_credentials.dpapi
exchange_settings.json

# WPF temp build artifacts (Visual Studio autogen, see archeology audit 2026-05-01)
**/*_wpftmp.csproj

# Worktrees (claude-code agents) — ephemeral, never commit
.claude/worktrees/

# Build output bundles (never commit — exceed GitHub 100MB limit)
dist/

# Runtime secrets � NEVER commit
**/appsettings.runtime.json
appsettings.runtime.json
**/.env
**/.env.local
**/.env.*.local
*.dpapi
.last_worker_log.txt
.tmp_*.ps1
logs/
*.xlsx
premortem-*.html
premortem-*.md

worker_*.log*
*.log.err

