## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This .gitignore is a combination of the GitHub VisualStudio.gitignore and common .NET Core patterns.

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]inaries/
*.sublime-project
*.sublime-workspace
_Chutzpah*
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you want to ignore settings per machine
# [Ss]ettings.zip

# Visual Studio Code
.vscode/

# OmniSharp
.omnisharp/

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet Focus mode
# **/packages/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Windows image-cache files
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on separate drives
$RECYCLE.BIN/

# VS Studio folders
.vs/

# Databases
*.db

# Logs
*.log
worker_log.txt
tmq-tests.log
