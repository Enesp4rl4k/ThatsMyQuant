  "Risk": {
    "PreEntry": {
      "_note": "Sized for the swing book: 19 basket legs + ETH 1h (MaxOpen 25); ETH 1h full position = 2000 x 0.5 x 0.75 x 1.5 = $1125 = 56% of basis (fat-finger 60%). Defaults (10 / 15%) blocked the basket and every ETH 1h entry.",
      "MaxOpenPositions": 25,
      "MaxPositionPctOfBasis": 0.6
    },
    "Supervisor": {
      "MonitoringIntervalMs": 1000,
      "MaxDrawdownPercent": 25.0,
      "BasisUsd": 2000,
      "EquityPollSeconds": 30
    }
  },
