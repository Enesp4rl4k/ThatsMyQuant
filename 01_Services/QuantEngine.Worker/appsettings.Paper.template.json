{
  "_readme": "TEMPLATE — copy to appsettings.Paper.json and fill OKX + Telegram credentials. The Paper.json copy is gitignored so secrets stay local. Loaded when DOTNET_ENVIRONMENT=Paper (set by Launch-PaperTrade.bat). See docs/PAPER_TRADE_LAUNCH_CHECKLIST.md.",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ThatsMyQuant": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "TMQ_MODE": "paper",
  "TMQ_EXCHANGE_MODE": "OKX",

  "ConnectionStrings": {
    "Quant": "Data Source=quant.db;Cache=Shared",
    "QuantPostgres": "Host=localhost;Port=5432;Database=thatsmyquant;Username=tmq;Password=REPLACE_ME"
  },

  "Persistence": {
    "Provider": "sqlite"
  },

  "OKX": {
    "ApiKey": "",
    "SecretKey": "",
    "Passphrase": "",
    "IsDemoMode": true
  },

  "Paper": {
    "Timeframe": "4h",
    "InitialBalance": 10000,
    "SyncWithExchange": true,
    "Leverage": {
      "Enabled": true,
      "Profile": "Moderate",
      "DefaultLeverage": 3.0,
      "MaxLeverage": 5.0,
      "MaintenanceMarginRate": 0.005,
      "LiquidationFeeRate": 0.0006,
      "FundingRateBpsPer8h": 1.0
    },
    "PortfolioLimits": {
      "MaxConcurrentPositions": 2,
      "MaxTotalNotionalRatio": 0.30,
      "ConsecutiveLossLookback": 4,
      "ConsecutiveLossCooldownThreshold": 3,
      "DailyLossLimitRatio": 0.02
    },
    "Realism": {
      "ApplyDepthAwareSlippage": true,
      "MinDepthSlippagePercent": 0.02,
      "MakerFillLatencyMs": 150,
      "TakerFillLatencyMs": 50
    }
  },

  "Markets": {
    "EnableCrypto": true,
    "EnableBist": false,
    "EnableForex": false
  },

  "Reconciliation": {
    "Enabled": true,
    "IntervalSeconds": 120,
    "TolerancePercent": 0.5
  },

  "OrderExecution": {
    "LimitOrderTimeoutSeconds": 20,
    "LimitFillPollIntervalMs": 1000
  },

  "Risk": {
    "Supervisor": {
      "MonitoringIntervalMs": 1000,
      "MaxDrawdownPercent": 3.0
    }
  },

  "RiskGovernor": {
    "MaxRequestedLeverage": 5.0,
    "MaxRequestedLeverageCross": 3.0,
    "MaxRequestedLeverageIsolated": 5.0
  },

  "StrategyPromotion": {
    "StrictSymbolIsolation": true,
    "CrossSymbolFallbackPenalty": 0.80
  },

  "Strategy": {
    "PairsTrading": {
      "Enabled": true,
      "Timeframe": "4h",
      "AllowedPairs": [
        { "SymbolY": "SOLUSDT", "SymbolX": "AVAXUSDT" }
      ],
      "ZScoreEntry": 2.0,
      "ZScoreExit": 0.3,
      "ZScoreStop": 3.0,
      "MinHurstExponent": 0.0,
      "MaxHurstExponent": 0.45,
      "MinHalfLifeBars": 5,
      "MaxHalfLifeBars": 80
    }
  },

  "QuantEngine": {
    "LiveSignalScan": {
      "Enabled": true,
      "IntervalMinutes": 15,
      "Symbols": "SOLUSDT,AVAXUSDT,DOGEUSDT"
    }
  },

  "Funding": {
    "Enabled": true,
    "Timeframe": "1h",
    "Universe": "DOGEUSDT",
    "NegativeThresholdBps": 2.0,
    "MaxConcurrent": 1
  },

  "Promotion": {
    "Paper": {
      "MinTrades": 8,
      "MinProfitFactor": 1.20,
      "MinWinRate": 0.45
    }
  },

  "Telegram": {
    "BotToken": "PUT_YOUR_BOT_TOKEN_HERE",
    "ChatId": "PUT_YOUR_CHAT_ID_HERE",
    "EnableReadBot": true,
    "AllowedChatIds": ""
  },

  "Management": {
    "Url": "http://127.0.0.1:18082"
  }
}
