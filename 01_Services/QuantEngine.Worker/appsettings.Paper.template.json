{
  "_readme": "TEMPLATE of the local paper/demo config (copy to appsettings.Paper.json; the copy is gitignored). Keep OKX/Telegram secrets EMPTY: Launch-PaperTrade-Clean.ps1 injects them from the DPAPI store. Paths assume C:/Users/<you>/Downloads/{Quantlab,ThatsMyQuant}.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ThatsMyQuant": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "TMQ_MODE": "paper",
  "TMQ_EXCHANGE_MODE": "OKX",
  "ConnectionStrings": {
    "Quant": "Data Source=quant.db;Cache=Shared"
  },
  "Persistence": {
    "Provider": "sqlite"
  },
  "OKX": {
    "ApiKey": "",
    "SecretKey": "",
    "Passphrase": "",
    "IsDemoMode": true
  },
  "Paper": {
    "Timeframe": "4h",
    "InitialBalance": 2000,
    "SyncWithExchange": true
  },
  "Markets": {
    "EnableCrypto": true,
    "EnableBist": false,
    "EnableForex": false
  },
  "Reconciliation": {
    "Enabled": true,
    "IntervalSeconds": 120,
    "TolerancePercent": 0.5
