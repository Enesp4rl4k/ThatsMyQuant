{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ai": {
    "GeminiApiKey": ""
  },
  "ConnectionStrings": {
    "Quant": "Data Source=quant.db;Cache=Shared"
  },
  "Risk": {
    "Supervisor": {
      "MonitoringIntervalMs": 1000,
      "MaxDrawdownPercent": 5.0
    }
  },
  "Inference": {
    "ModelPath": "PredictiveAlphaModel.zip",
    "PredictionEngineCount": 0,
    "MaxPredictionEngines": 0,
    "UseParallelWarmup": true,
    "LazyPoolWarmup": true,
    "LazyPoolBackgroundLogLevel": "Warning"
  },
  "Execution": {
    "UseWorkerHandoff": true,
    "Leverage": {
      "DefaultLeverage": 1.0,
      "DefaultMarginMode": "Isolated"
    }
  },
  "Edge": {
    "Enabled": true,
    "PipelineKind": "Live",
    "ProbeSimulatedMultiplier": 0.45
  },
  "Paper": {
    "Timeframe": "15m",
    "Leverage": {
      "Enabled": true,
      "DefaultLeverage": 1.0,
      "MaxLeverage": 3.0,
      "MaintenanceMarginRate": 0.005,
      "LiquidationFeeRate": 0.0006,
      "FundingRateBpsPer8h": 1.0
    }
  },
  "RiskGovernor": {
    "MaxRequestedLeverage": 3.0,
    "MaxRequestedLeverageCross": 2.0,
    "MaxRequestedLeverageIsolated": 3.0
  },
  "QuantEngine": {
    "LiveSignalScan": {
      "Enabled": false,
      "IntervalMinutes": 15,
      "Symbols": ""
    }
  },
  "Promotion": {
    "Backtest": {
      "MinTrades": 6,
      "MinProfitFactor": 1.15,
      "MinWinRate": 0.42
    },
    "Paper": {
      "MinTrades": 8,
      "MinProfitFactor": 1.20,
      "MinWinRate": 0.45
    }
  },
  "Management": {
    "Url": "http://127.0.0.1:18082"
  },
  "Backtest": {
    "Parity": {
      "RequireParityCoverage": true,
      "RequireMlModelAvailability": true
    }
  }
}
