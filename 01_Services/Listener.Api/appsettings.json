{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WebhookSecret": "change-me-in-production-use-user-secrets",
  "Security": {
    "InternalApiKey": "change-me-in-production-use-user-secrets",
    "WebhookTimestampWindowMinutes": 5
  },
  "Execution": {
    "UseWorkerHandoff": true,
    "Leverage": {
      "DefaultLeverage": 1.0,
      "DefaultMarginMode": "Isolated"
    },
    "OrderBook": {
      "Enabled": true,
      "EnableForHft": false,
      "MaxSpreadPercent": 0.35,
      "MinTopImbalanceForBuy": 0.38,
      "MaxTopImbalanceForSell": 0.62,
      "QuantityReductionFactor": 0.82,
      "BlockOnWideSpread": true,
      "ReduceQuantityOnWeakSide": true,
      "UseForAlphaModulation": true,
      "AlphaMaxConfidenceDelta": 6.0
    }
  },
  "Edge": {
    "Enabled": true,
    "PipelineKind": "Live",
    "ProbeSimulatedMultiplier": 0.45
  },
  "Risk": {
    "Supervisor": {
      "MonitoringIntervalMs": 1000,
      "MaxDrawdownPercent": 5.0
    }
  },
  "RiskGovernor": {
    "MaxRequestedLeverage": 3.0,
    "MaxRequestedLeverageCross": 2.0,
    "MaxRequestedLeverageIsolated": 3.0
  },
  "Inference": {
    "ModelPath": "PredictiveAlphaModel.zip",
    "PredictionEngineCount": 0,
    "MaxPredictionEngines": 0,
    "UseParallelWarmup": true,
    "LazyPoolWarmup": true,
    "LazyPoolBackgroundLogLevel": "Warning"
  },
  "Promotion": {
    "Backtest": {
      "MinTrades": 6,
      "MinProfitFactor": 1.15,
      "MinWinRate": 0.42
    },
    "Paper": {
      "MinTrades": 8,
      "MinProfitFactor": 1.20,
      "MinWinRate": 0.45
    }
  },
  "ConnectionStrings": {
    "QuantDb": "Data Source=quantbot.db",
    "Quant": "Data Source=quant.db;Cache=Shared"
  },
  "Backtest": {
    "Parity": {
      "RequireParityCoverage": true,
      "RequireMlModelAvailability": true
    }
  }
}
